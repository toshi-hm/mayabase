{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/videos/index.html",
        "/videos/category/gadget/index.html",
        "/videos/series/index.html",
        "/videos/series/futatsu-no-waraji/index.html",
        "/gear/index.html",
        "/glossary/index.html",
        "/faq/index.html",
        "/topics/index.html",
        "/watch-later/index.html",
        "/404.html"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$)(?!.*/watch-later/).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.75 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "(.*/404\\.html$)|(.*/watch-later/.*)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.75 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": "off"
          }
        }
      ]
    }
  }
}
