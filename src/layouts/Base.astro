---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WatchLaterController from "../components/WatchLaterController.astro";
import { site } from "../config/site";
import { THEME_STORAGE_KEY } from "../lib/theme";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * ページ内容に応じたOGP画像パス（`public/` からの絶対パス、または外部の絶対URL）。
   * 外部URLの場合も `new URL(ogImagePath, Astro.site)` が絶対URLをそのまま採用するため
   * 問題なく使える。未指定時はサイト共通の `/ogp.png` (#16)。
   */
  ogImagePath?: string;
  /** OGP画像のalt文言。`ogImagePath` を指定する場合は画像内容に合わせて併せて指定する。 */
  ogImageAlt?: string;
  /** OGP画像の幅・高さ(px)。未指定時は共通OGP画像の実寸(1200x630)。 */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** `<meta name="robots">` の content。404ページ等、検索結果に出したくないページで指定する。 */
  robots?: string;
}

const {
  title = `${site.name} | ITで日常をより便利に`,
  description = site.description,
  ogImagePath = "/ogp.png",
  ogImageAlt = `${site.name} - ITで日常をより便利に`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  robots,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} 新着動画`}
      href="/rss.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta
      id="theme-color-light"
      name="theme-color"
      content="#fdfcf9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      id="theme-color-dark"
      name="theme-color"
      content="#11171d"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />

    {
      /*
        ダークモード手動切り替え(#135)のFOUC対策。
        CSSは prefers-color-scheme に加え <html> の theme-dark / theme-light クラスでも
        トークンを上書きできるため(global.css)、初回ペイント前に同期実行でクラスを確定させる。
        type="module" は読み込みが非同期化されチラつきの原因になるため、is:inline で
        素のスクリプトとして即時実行する。ロジックは src/lib/theme.ts の
        parseStoredTheme / resolveTheme / themeColorMedia と同等だが、
        非同期化できない制約上ここではバニラJSに複製している(変更時は両方を揃えること)。
      */
    }
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      (function () {
        var THEMES = ["system", "light", "dark"];
        var stored = null;
        try {
          stored = localStorage.getItem(storageKey);
        } catch (e) {
          // プライベートモード等で localStorage が使えない場合は system 扱いにする
        }
        var theme = THEMES.indexOf(stored) !== -1 ? stored : "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var resolved = theme === "system" ? (prefersDark ? "dark" : "light") : theme;
        document.documentElement.classList.add(resolved === "dark" ? "theme-dark" : "theme-light");

        if (theme !== "system") {
          var lightMeta = document.getElementById("theme-color-light");
          var darkMeta = document.getElementById("theme-color-dark");
          if (lightMeta) lightMeta.setAttribute("media", resolved === "light" ? "all" : "not all");
          if (darkMeta) darkMeta.setAttribute("media", resolved === "dark" ? "all" : "not all");
        }
      })();
    </script>

    {/* OGP */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* X (Twitter) Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${site.x.account}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <slot name="head" />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only rounded-md bg-brand px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      本文へスキップ
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    {
      /* 全ページ共通のオンサイト・プレビュー再生ライトボックス(#69)。カード側は data 属性で連携する */
    }
    <VideoLightbox />
    {/* 「あとで見る」ローカルブックマークのクリック処理(#216)。DOM は持たずスクリプトのみ */}
    <WatchLaterController />
  </body>
</html>
