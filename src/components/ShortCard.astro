---
import { formatDateJa } from "../lib/format";
import { thumbnailFallbackUrl, type Video, videoUrl } from "../lib/youtube";
import PreviewButton from "./PreviewButton.astro";
import ShareButton from "./ShareButton.astro";
import WatchLaterButton from "./WatchLaterButton.astro";

interface Props {
  video: Video;
  /** スライド位置(1 始まり) */
  position: number;
  /** スライド総数 */
  total: number;
  /** ファーストビューに入るカードは true(LCP 対策で eager 読み込み) */
  eager?: boolean;
}

const { video, position, total, eager = false } = Astro.props;
---

<li
  class="relative w-[40%] flex-none sm:w-[30%] lg:w-[15.2%]"
  role="listitem"
  aria-roledescription="スライド"
  aria-label={`${position} / ${total}`}
>
  {
    /* data-watch-track-id は「前回の続きから」導線(#188)向け。クリックを
    ContinueWatchingController.astro が拾い、localStorage に視聴履歴として記録する。 */
  }
  <a
    href={videoUrl(video)}
    target="_blank"
    rel="noopener noreferrer"
    data-watch-track-id={video.id}
    class="group/card block overflow-hidden rounded-xl bg-surface-raised transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-brand"
  >
    {/* Shorts は縦型のため 4:3 サムネイルを 9:16 枠で中央トリミングする */}
    <img
      src={thumbnailFallbackUrl(video.id)}
      alt=""
      width="480"
      height="360"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      class="aspect-[9/16] w-full object-cover"
    />
    <div class="p-3">
      <h3
        class="line-clamp-2 text-sm font-semibold leading-snug group-hover/card:text-brand-accent"
      >
        {video.title}
        <span class="sr-only">(YouTube・新しいタブで開きます)</span>
      </h3>
      <p class="mt-1.5 text-xs text-ink-muted">
        <time datetime={video.publishedAt}>{formatDateJa(video.publishedAt)}</time>
      </p>
    </div>
  </a>
  <PreviewButton videoId={video.id} title={video.title} aspect="short" />
  <ShareButton title={video.title} url={videoUrl(video)} />
  <WatchLaterButton videoId={video.id} title={video.title} aspect="short" />
</li>
