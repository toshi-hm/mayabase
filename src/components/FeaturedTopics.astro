---
import { CATEGORY_LABELS, categoryUrl } from "../lib/categories";
import type { FeaturedTopic } from "../lib/featuredTopics";
import VideoCard from "./VideoCard.astro";

interface Props {
  topics: FeaturedTopic[];
}

const { topics } = Astro.props;
---

<section aria-labelledby="featured-topics-heading" class="bg-surface-mint py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-sm font-bold text-brand-accent">NOW TRENDING</p>
        <h2 id="featured-topics-heading" class="text-2xl font-black sm:text-3xl">
          いま注目のテーマ
        </h2>
        <p class="mt-2 max-w-2xl text-ink-muted">
          最近気になるIT・ガジェットのテーマから、次に見る動画を探せます。
        </p>
      </div>
    </div>
    <div class="grid gap-8 lg:grid-cols-2">
      {
        topics.map((topic) => {
          const [featuredVideo, ...relatedVideos] = topic.videos;
          return (
            <article class="rounded-xl border border-line bg-surface p-5 shadow-sm sm:p-6">
              <header>
                <h3 class="text-xl font-black">{topic.title}</h3>
                <p class="mt-2 leading-relaxed text-ink-muted">{topic.description}</p>
                <a
                  href={categoryUrl(topic.category)}
                  class="mt-3 inline-flex text-sm font-semibold text-brand-accent underline underline-offset-4"
                >
                  {CATEGORY_LABELS[topic.category]}の動画をすべて見る
                </a>
              </header>
              <ul role="list" class="mt-5">
                {featuredVideo && (
                  <VideoCard
                    video={featuredVideo}
                    position={1}
                    total={topic.videos.length}
                    layout="grid"
                    featured
                  />
                )}
              </ul>
              {
                relatedVideos.length > 0 && (
                  <div class="mt-6 border-t border-line pt-5">
                    <h4 class="mb-4 text-sm font-bold text-ink-muted">関連動画</h4>
                    <ul role="list" class="grid gap-4 sm:grid-cols-2">
                      {relatedVideos.map((video, index) => (
                        <VideoCard
                          video={video}
                          position={index + 2}
                          total={topic.videos.length}
                          layout="grid"
                        />
                      ))}
                    </ul>
                  </div>
                )
              }
            </article>
          );
        })
      }
    </div>
  </div>
</section>
