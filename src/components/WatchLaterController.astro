---
/**
 * 「あとで見る」ローカルブックマーク機能(#216)のクリック処理を一元管理するコントローラー。
 * VideoLightbox.astro と同じ方針で Base.astro に 1 つだけ配置し、ページ内の全ての
 * WatchLaterButton.astro インスタンス(data-watch-later-id 属性)からのクリックを
 * イベント委譲で拾う。DOM 要素自体は持たない(スクリプトのみ)。
 */
---

<script>
  import {
    parseStoredWatchLaterIds,
    toggleWatchLaterId,
    WATCH_LATER_STORAGE_KEY,
  } from "../lib/watchLater";

  function readStoredIds(): string[] {
    let raw: string | null = null;
    try {
      raw = localStorage.getItem(WATCH_LATER_STORAGE_KEY);
    } catch {
      // プライベートモード等で localStorage が使えない場合は空扱い
    }
    return parseStoredWatchLaterIds(raw);
  }

  function writeStoredIds(ids: string[]): void {
    try {
      localStorage.setItem(WATCH_LATER_STORAGE_KEY, JSON.stringify(ids));
    } catch {
      // 保存に失敗しても当該セッション内の表示切り替え自体は継続する
    }
  }

  function applyButtonState(button: HTMLElement, saved: boolean): void {
    const title = button.dataset.watchLaterTitle ?? "";
    button.setAttribute("aria-pressed", String(saved));
    button.setAttribute(
      "aria-label",
      saved ? `「${title}」をあとで見るから削除` : `「${title}」をあとで見るに追加`,
    );
  }

  // root 配下のボタンを、保存済みID一覧に照らして初期状態に同期する
  function syncButtonsIn(root: ParentNode): void {
    const savedIds = readStoredIds();
    for (const button of root.querySelectorAll<HTMLElement>("[data-watch-later-id]")) {
      const id = button.dataset.watchLaterId;
      if (id) applyButtonState(button, savedIds.includes(id));
    }
  }

  // ページ内の全ボタンを初期状態に同期する
  syncButtonsIn(document);

  // index.astro の「気になるテーマは?」導線(#217)等、DOM 肥大化対策で <template> の中身を
  // クライアント側で後から実体化するページ向けのフック。新しく挿入された DOM にも保存済み状態を反映する。
  document.addEventListener("mayabase:card-materialized", (event) => {
    const root = (event as CustomEvent<{ root?: ParentNode }>).detail?.root;
    if (root) syncButtonsIn(root);
  });

  // イベント委譲: ページ内に何百枚カードがあってもリスナーは1つで済む
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLElement>("[data-watch-later-id]");
    if (!button) return;
    const id = button.dataset.watchLaterId;
    if (!id) return;

    const nextIds = toggleWatchLaterId(readStoredIds(), id);
    writeStoredIds(nextIds);
    const saved = nextIds.includes(id);

    // 同じ動画のボタンは一覧・カルーセル・関連動画等、同一ページ内に複数存在し得るため全て同期する
    for (const match of document.querySelectorAll<HTMLElement>(
      `[data-watch-later-id="${CSS.escape(id)}"]`,
    )) {
      applyButtonState(match, saved);
    }

    // /watch-later/ ページ等、保存状態の変化を監視したいページへ通知する
    window.dispatchEvent(new CustomEvent("watch-later-change", { detail: { id, saved } }));
  });
</script>
