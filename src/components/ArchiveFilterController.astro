---
/**
 * カテゴリ別ページ・シリーズページ向けの「動画の長さ」絞り込み・キーワード検索・人気順並び替え(#275, #342)。
 * videos.astro のフィルタースクリプトから、カテゴリ絞り込み・段階表示(<template>実体化)を
 * 除いた「長さ + キーワード + 並び替え」部分だけを共通化したもの。カテゴリ別ページはページ自体が既に1カテゴリに
 * 絞られており、シリーズページにもカテゴリ概念が無いため、カテゴリ絞り込みは対象外にしている。
 *
 * INITIAL_COUNT 超過分の段階表示(<template>実体化)は videos.astro (#177) と同じ方針で
 * このコントローラーにも実装している(#419: 以前はカテゴリ別・シリーズ別ページだけ全件を
 * 即座にDOMへ描画しており、動画数が増えるとDOMサイズが線形に増加し続ける問題があった)。
 *
 * 各ページ側は以下のマークアップ規約に従うことを前提にする:
 * - `#archive-search`: キーワード検索の input[type=search]
 * - `[data-filter-length]`(値: all/video/short): 長さ絞り込みボタン
 * - `[data-filter-duration]`(値: all/under5/5to15/over15): 尺(再生時間)絞り込みボタン(#330)。
 *   duration が1件も無い環境ではページ側がそもそも描画しない(hasViewCounts と同じ方針)ため任意。
 * - `#archive-grid`: `data-initial-count` を持ち、`<li data-length data-duration-bucket data-title
 *   data-view-count>`(ArchiveCard.astro が既に付与)、または INITIAL_COUNT 超過分は同じ data-* を
 *   持つ `<template data-video-slot>` を並べたコンテナ(#419)
 * - `#archive-count`: 該当件数を表示する要素(aria-live 推奨)
 * - `#archive-empty`: 0件時に表示する要素(通常は hidden)
 * - `#archive-more`: 「もっと見る」ボタン(通常は hidden)。INITIAL_COUNT 超過分が無いページでは
 *   常に非表示のまま(#419)
 * - `[data-sort-order]`(値: newest/popular): 並び替えボタン。viewCount が1件も無い環境では
 *   ページ側がそもそも描画しない(videos.astro の hasViewCounts と同じ方針)ため任意。
 */
---

<script>
  import { parseViewCountAttr, textMatchesKeyword } from "../lib/format";

  const grid = document.getElementById("archive-grid");
  // サーバー側(各ページのフロントマター)の値を data 属性経由で受け取り、二重定義を避ける(#419)
  const INITIAL_COUNT = Number((grid as HTMLElement | null)?.dataset.initialCount) || Infinity;
  const search = document.getElementById("archive-search") as HTMLInputElement | null;
  const lengthButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter-length]");
  const durationButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter-duration]");
  const sortButtons = document.querySelectorAll<HTMLButtonElement>("[data-sort-order]");
  const count = document.getElementById("archive-count");
  const empty = document.getElementById("archive-empty");
  const moreButton = document.getElementById("archive-more") as HTMLButtonElement | null;

  // INITIAL_COUNT 超過分は <li> ではなく <template data-video-slot> として描画されている(#419)。
  // <template> の中身はメインドキュメントの DOM ツリーに含まれないため、表示が必要になるまでは
  // Lighthouse の DOM サイズ計測やレイアウトの対象にならない。「表示が必要」と判定された時点で
  // materialize() が template.content を複製して実際の <li> に差し替える(videos.astro と同じ方針)。
  type CardSlot = HTMLLIElement | HTMLTemplateElement;

  // 並び替え時に「新しい順」へ戻すための元の DOM 順(= 各ページのデータ降順)。
  const originalOrder: CardSlot[] = grid
    ? [...grid.querySelectorAll<CardSlot>(":scope > li, :scope > template[data-video-slot]")]
    : [];
  // applyFilter が参照する「現在の表示順」。並び替え時に reorderGrid() が差し替える。
  let cards: CardSlot[] = originalOrder;

  // このコントローラーを使うページが無い(該当マークアップが存在しない)場合は何もしない
  if (grid && cards.length > 0) {
    let length: "all" | "video" | "short" = "all";
    let durationBucket: "all" | "under5" | "5to15" | "over15" = "all";
    let sortOrder: "newest" | "popular" = "newest";
    // 一度展開したら以降は全件表示のまま(ボタンは二度と出さない・videos.astro と同じ方針)
    let expanded = false;
    const validLengths = new Set(
      [...lengthButtons].map((button) => button.dataset.filterLength ?? "all"),
    );
    const validDurationBuckets = new Set(
      [...durationButtons].map((button) => button.dataset.filterDuration ?? "all"),
    );

    // template.content の中身を複製して実際の <li> に差し替える(未実体化でなければ何もせず返す)。
    // originalOrder / cards の両方を、差し替え後も同じ位置を指すよう更新する(videos.astro と同じ方針)。
    function materialize(slot: CardSlot): HTMLLIElement {
      if (!(slot instanceof HTMLTemplateElement)) return slot;
      const li = slot.content.firstElementChild?.cloneNode(true) as HTMLLIElement;
      slot.replaceWith(li);
      const originalIndex = originalOrder.indexOf(slot);
      if (originalIndex !== -1) originalOrder[originalIndex] = li;
      if (cards !== originalOrder) {
        const cardsIndex = cards.indexOf(slot);
        if (cardsIndex !== -1) cards[cardsIndex] = li;
      }
      document.dispatchEvent(
        new CustomEvent("mayabase:card-materialized", { detail: { root: li } }),
      );
      return li;
    }

    function setPressedLength(nextLength: string): void {
      for (const button of lengthButtons) {
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.filterLength ?? "all") === nextLength),
        );
      }
    }

    function setPressedDuration(nextBucket: string): void {
      for (const button of durationButtons) {
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.filterDuration ?? "all") === nextBucket),
        );
      }
    }

    // Shorts は尺バケットを持たない(videoDurationBucket)ため、「Shorts」×「特定の尺」は
    // 構造的に常に0件になる。selectできてしまうこと自体を防ぐため、
    // 「Shorts」選択中は尺フィルターを無効化し、選択状態も「すべての尺」へ戻す(#400)。
    function applyDurationAvailability(): void {
      const disabled = length === "short";
      for (const button of durationButtons) {
        button.disabled = disabled;
        button.setAttribute("aria-disabled", String(disabled));
      }
      if (disabled && durationBucket !== "all") {
        durationBucket = "all";
        setPressedDuration(durationBucket);
      }
    }

    function setPressedSortOrder(nextOrder: "newest" | "popular"): void {
      for (const button of sortButtons) {
        const buttonOrder = button.dataset.sortOrder === "popular" ? "popular" : "newest";
        button.setAttribute("aria-pressed", String(buttonOrder === nextOrder));
      }
    }

    // card は未実体化の <template> の場合もあるため、判定は data-* のみで行う(videos.astro と同じ方針)。
    function cardMatches(card: CardSlot, query: string): boolean {
      return (
        (length === "all" || card.dataset.length === length) &&
        (durationBucket === "all" || card.dataset.durationBucket === durationBucket) &&
        textMatchesKeyword(card.dataset.title ?? "", query)
      );
    }

    function applyFilter(): void {
      const query = (search?.value ?? "").trim().toLowerCase();
      let matched = 0; // 条件に一致する総数
      let shown = 0; // 実際に表示している数(未展開時は INITIAL_COUNT で頭打ち)
      for (let i = 0; i < cards.length; i++) {
        const slot = cards[i];
        if (cardMatches(slot, query)) {
          matched += 1;
          const withinLimit = expanded || matched <= INITIAL_COUNT;
          if (withinLimit) {
            // 表示が必要になった時点で初めて実体化する。まだ一致していないカードは
            // template のままにしておくことで、通常時の DOM サイズを抑える(#419)。
            const li = materialize(slot);
            cards[i] = li;
            li.hidden = false;
            shown += 1;
          } else if (slot instanceof HTMLLIElement) {
            slot.hidden = true;
          }
        } else if (slot instanceof HTMLLIElement) {
          slot.hidden = true;
        }
      }
      if (count) count.textContent = `${matched} 件`;
      if (empty) empty.hidden = matched > 0;

      const remaining = matched - shown;
      if (moreButton) {
        if (!expanded && remaining > 0) {
          moreButton.hidden = false;
          moreButton.textContent = `もっと見る(残り ${remaining} 件)`;
        } else {
          moreButton.hidden = true;
        }
      }
    }

    // カードを DOM 上で並び替える(videos.astro の reorderGrid と同じ方針。
    // appendChild は既存ノードの移動であり複製ではないため、イベントリスナー等はそのまま保たれる。
    // <template> 要素もそのまま移動できる)
    function reorderGrid(order: "newest" | "popular"): void {
      const sorted =
        order === "popular"
          ? [...originalOrder].sort(
              (a, b) =>
                parseViewCountAttr(b.dataset.viewCount) - parseViewCountAttr(a.dataset.viewCount),
            )
          : originalOrder;
      for (const card of sorted) {
        grid?.appendChild(card);
      }
      cards = sorted;
    }

    // 長さ・検索キーワード・並び替えをURLクエリパラメータ(length/q/order)へ反映する(videos.astro と同じ方針)。
    function syncUrl(mode: "push" | "replace"): void {
      const params = new URLSearchParams();
      if (length !== "all") params.set("length", length);
      if (durationBucket !== "all") params.set("duration", durationBucket);
      const query = (search?.value ?? "").trim();
      if (query) params.set("q", query);
      if (sortOrder !== "newest") params.set("order", sortOrder);
      const queryString = params.toString();
      const newUrl = `${location.pathname}${queryString ? `?${queryString}` : ""}${location.hash}`;
      if (mode === "push") {
        history.pushState(null, "", newUrl);
      } else {
        history.replaceState(null, "", newUrl);
      }
    }

    // クエリパラメータ(length / q / order)から絞り込み・並び替え状態を復元する。
    // 不正な length / order はそれぞれデフォルトへ戻す。
    // expanded(「もっと見る」展開状態)はURLに含めていないため、popstate 時は常に未展開に戻す
    // (videos.astro と同じ方針。でないと戻る操作後も絞り込み変更前の全件展開表示が残ってしまう)。
    function restoreStateFromUrl(): void {
      expanded = false;
      const params = new URLSearchParams(location.search);
      const urlLength = params.get("length");
      length =
        urlLength && validLengths.has(urlLength) ? (urlLength as "all" | "video" | "short") : "all";
      setPressedLength(length);
      const urlDuration = params.get("duration");
      durationBucket =
        length !== "short" && urlDuration && validDurationBuckets.has(urlDuration)
          ? (urlDuration as "all" | "under5" | "5to15" | "over15")
          : "all";
      setPressedDuration(durationBucket);
      applyDurationAvailability();
      if (search) search.value = params.get("q") ?? "";

      // 並び替えトグル自体が無い環境(viewCount 未取得)では order パラメータを無視する
      if (sortButtons.length > 0) {
        sortOrder = params.get("order") === "popular" ? "popular" : "newest";
        setPressedSortOrder(sortOrder);
        reorderGrid(sortOrder);
      }
    }

    for (const button of lengthButtons) {
      button.addEventListener("click", () => {
        const value = button.dataset.filterLength;
        length = value === "video" || value === "short" ? value : "all";
        setPressedLength(length);
        applyDurationAvailability();
        // 独立した絞り込み状態への切り替えとみなし、展開状態をリセットする(videos.astro #273 と同じ方針)
        expanded = false;
        applyFilter();
        syncUrl("push");
      });
    }

    for (const button of durationButtons) {
      button.addEventListener("click", () => {
        const value = button.dataset.filterDuration;
        durationBucket =
          value === "under5" || value === "5to15" || value === "over15" ? value : "all";
        setPressedDuration(durationBucket);
        expanded = false;
        applyFilter();
        syncUrl("push");
      });
    }

    for (const button of sortButtons) {
      button.addEventListener("click", () => {
        sortOrder = button.dataset.sortOrder === "popular" ? "popular" : "newest";
        setPressedSortOrder(sortOrder);
        reorderGrid(sortOrder);
        expanded = false;
        applyFilter();
        syncUrl("push");
      });
    }

    search?.addEventListener("input", () => {
      expanded = false;
      applyFilter();
      // 入力のたびに履歴エントリを増やすとブラウザ履歴がスパムになるため、現在のエントリを上書きする
      syncUrl("replace");
    });

    moreButton?.addEventListener("click", () => {
      // 展開直前に「これから現れる最初のカード」の位置を控えておき、展開後にフォーカスを移す
      // (videos.astro の moreButton ハンドラーと同じ方針)。applyFilter() が template を <li> に
      // 実体化して cards の中身を差し替えるため、要素参照ではなくインデックスで覚えておき、
      // 実体化後の要素を改めて読み直す。
      const query = (search?.value ?? "").trim().toLowerCase();
      const firstRevealedIndex = cards.findIndex((card) => {
        const isHidden = card instanceof HTMLTemplateElement || card.hidden;
        return isHidden && cardMatches(card, query);
      });
      expanded = true;
      applyFilter();
      const revealed = firstRevealedIndex !== -1 ? cards[firstRevealedIndex] : undefined;
      if (revealed instanceof HTMLLIElement) revealed.querySelector("a")?.focus();
    });

    window.addEventListener("popstate", () => {
      restoreStateFromUrl();
      applyFilter();
    });

    restoreStateFromUrl();
    applyFilter();
  }
</script>
