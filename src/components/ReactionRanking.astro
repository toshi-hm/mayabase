---
interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
---

{
  /*
    section自体をhidden(display:none)にすると、データ取得前のIntersectionObserverが
    永久に発火しなくなる(display:noneの要素はビューポートと交差し得ない)ため、
    観測専用の高さ1pxのセンチネルを別要素として置き、これをスクロール検知に使う(#534)。
  */
}
<div id="reaction-ranking-sentinel" aria-hidden="true" class="h-px"></div>
<section
  id="reaction-ranking"
  aria-labelledby="reaction-ranking-heading"
  hidden
  data-limit={limit}
  class="bg-surface-raised py-16"
>
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-8">
      <h2 id="reaction-ranking-heading" class="text-2xl font-black">みんなが気になっている動画</h2>
      <p id="reaction-ranking-status" class="mt-2 text-sm text-ink-muted" aria-live="polite">
        リアクションを集計しています。
      </p>
    </div>
    <ul id="reaction-ranking-list" role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    </ul>
  </div>
</section>

<script>
  import {
    parseReactionRankingCandidates,
    sortReactionRanking,
    type ReactionRankingCandidate,
  } from "../lib/reactionRanking";
  import { thumbnailFallbackUrl } from "../lib/youtube";

  type RankingCandidate = ReactionRankingCandidate;

  const section = document.getElementById("reaction-ranking");
  const list = document.getElementById("reaction-ranking-list");
  const status = document.getElementById("reaction-ranking-status");
  const isStaticPreview = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
  const rankingLimit = Number.parseInt(section?.dataset.limit ?? "6", 10);

  // 表示するのは上位6件のみだが、反応数に基づくランキングのため候補自体は全動画から
  // 絞り込む必要がある。動画数が増えても初期HTMLペイロードを肥大化させないよう、
  // 候補データはビルド時生成の静的JSON(#534)としてセクションが実際にビューポートへ
  // 入った時点でのみ取得する(video-descriptions.json.ts等と同じ方針)。
  const loadCandidates = async (): Promise<RankingCandidate[]> => {
    const response = await fetch("/reaction-ranking-candidates.json");
    if (!response.ok) return [];
    const parsed: unknown = await response.json();
    return parseReactionRankingCandidates(parsed);
  };

  const loadReactionCounts = async (
    candidates: readonly RankingCandidate[],
  ): Promise<Map<string, number> | null> => {
    const counts = new Map<string, number>();
    for (let start = 0; start < candidates.length; start += 200) {
      const chunk = candidates.slice(start, start + 200);
      const response = await fetch(
        "/api/video-reaction?videoIds=" +
          encodeURIComponent(chunk.map((item) => item.id).join(",")),
      );
      if (!response.ok) return null;
      const data = (await response.json()) as { counts?: unknown };
      if (typeof data.counts !== "object" || data.counts === null) return null;
      for (const [videoId, count] of Object.entries(data.counts)) {
        if (typeof count !== "number" || !Number.isSafeInteger(count) || count < 0) return null;
        counts.set(videoId, count);
      }
    }
    return counts;
  };

  const createCard = (candidate: RankingCandidate, count: number): HTMLLIElement => {
    const item = document.createElement("li");
    item.className = "overflow-hidden rounded-xl border border-line bg-surface";
    const link = document.createElement("a");
    link.href = `/videos/${encodeURIComponent(candidate.id)}/`;
    link.className =
      "group block h-full transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-brand";
    const image = document.createElement("img");
    image.src = thumbnailFallbackUrl(candidate.id);
    image.alt = "";
    image.width = 480;
    image.height = 360;
    image.loading = "lazy";
    image.decoding = "async";
    image.className = "aspect-video w-full object-cover";
    const body = document.createElement("div");
    body.className = "p-4";
    const title = document.createElement("h3");
    title.className = "line-clamp-2 font-semibold leading-snug group-hover:text-brand-accent";
    title.textContent = candidate.title;
    const meta = document.createElement("p");
    meta.className = "mt-2 flex items-center gap-2 text-sm text-ink-muted";
    const reaction = document.createElement("span");
    reaction.className = "rounded-full bg-brand/10 px-2 py-0.5 font-semibold text-brand-accent";
    reaction.textContent = `気になる ${count}件`;
    meta.append(reaction);
    if (candidate.isShort) {
      const shortLabel = document.createElement("span");
      shortLabel.className = "rounded-full bg-brand px-2 py-0.5 text-xs font-semibold text-white";
      shortLabel.textContent = "Shorts";
      meta.append(shortLabel);
    }
    body.append(title, meta);
    link.append(image, body);
    item.append(link);
    return item;
  };

  const renderRanking = async (): Promise<void> => {
    if (!list || !status) return;
    try {
      const candidates = await loadCandidates();
      if (candidates.length === 0) return;
      const counts = await loadReactionCounts(candidates);
      if (!counts) return;
      // sortReactionRanking が反応0件の候補を除外するため、結果が空なら
      // 「気になる」が1件も付いていない状態(セクション自体を表示しない)。
      const ranked = sortReactionRanking(candidates, counts, rankingLimit);
      if (ranked.length === 0) return;
      list.replaceChildren(
        ...ranked.map((candidate) => createCard(candidate, counts.get(candidate.id) ?? 0)),
      );
      status.textContent = "「気になる」の反応が多い順に表示しています。";
      if (section) section.hidden = false;
    } catch {
      // 候補データ・リアクションAPI障害時は集計中のセクションを表示しない。
    }
  };

  const sentinel = document.getElementById("reaction-ranking-sentinel");

  if (!isStaticPreview && section && list && status) {
    if (sentinel && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          sentinel.remove();
          void renderRanking();
        },
        { rootMargin: "200px" },
      );
      observer.observe(sentinel);
    } else {
      sentinel?.remove();
      void renderRanking();
    }
  }
</script>
