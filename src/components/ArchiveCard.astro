---
import { CATEGORY_LABELS, type VideoCategory } from "../lib/categories";
import { formatDateJa, formatViewCount } from "../lib/format";
import { gearDisplayName, type GearItem } from "../lib/gear";
import { thumbnailFallbackUrl, thumbnailUrl, type Video, videoUrl } from "../lib/youtube";
import PreviewButton from "./PreviewButton.astro";
import ShareButton from "./ShareButton.astro";
import WatchLaterButton from "./WatchLaterButton.astro";

interface Props {
  video: Video;
  category: VideoCategory;
  /** 一覧の先頭カードは LCP 対策で優先読み込みする */
  eager?: boolean;
  /** LCP 対象など、ローカル配信するサムネイルがある場合に指定する */
  thumbnailSrc?: string;
  /** この動画で紹介されているガジェット(愛用ガジェットとの相互リンク用・#70) */
  gearItems?: GearItem[];
  /** 初期表示時から `hidden` 属性で隠しておきたい場合に指定する(例: watch-later.astro) */
  hidden?: boolean;
}

const {
  video,
  category,
  eager = false,
  thumbnailSrc,
  gearItems = [],
  hidden = false,
} = Astro.props;
// RSS のみ(YOUTUBE_API_KEY 未設定)の環境では取得できず null になる(#35 と同じフォールバック方針)
const viewCountLabel = video.viewCount !== null ? formatViewCount(video.viewCount) : null;
---

{
  /* data-* はクライアントサイドの絞り込み・検索・並び替えで参照する(videos.astro)。
  表示・非表示は `hidden` 属性(DOM の `.hidden`)で一元的に制御する。
  data-view-count は「人気順」ソートの並び替えキー。未取得(null)の動画は空文字にし、
  クライアント側でソート時に最下位扱いにする。
  この <li> は videos.astro から直接描画される場合と、DOM 肥大化対策で <template> の中身として
  描画され、必要になった時点でのみクライアント側で複製・挿入される場合がある(#177)。
  後者のケースでも同じ data-* を <template> 自体にも付与しておくことで、実体化前でも
  絞り込み・並び替えの判定に使えるようにしている。 */
}
<li
  class="relative"
  data-category={category}
  data-title={video.title.toLowerCase()}
  data-video-id={video.id}
  data-view-count={video.viewCount ?? ""}
  hidden={hidden}
>
  <div
    class="group/card flex h-full flex-col overflow-hidden rounded-xl bg-surface-raised transition hover:-translate-y-1 hover:shadow-lg"
  >
    <a
      href={videoUrl(video)}
      target="_blank"
      rel="noopener noreferrer"
      class="focus-visible:outline-2 focus-visible:outline-brand"
    >
      <div class="relative">
        {/* Shorts も 16:9 で統一表示する(縦型サムネイルは中央トリミングされる) */}
        <img
          src={thumbnailSrc ?? (eager ? thumbnailFallbackUrl(video.id) : thumbnailUrl(video.id))}
          onerror={eager || thumbnailSrc
            ? undefined
            : `this.onerror=null;this.src='${thumbnailFallbackUrl(video.id)}'`}
          alt=""
          width="1280"
          height="720"
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          class="aspect-video w-full object-cover"
        />
        {
          video.isShort && (
            <span class="absolute top-2 left-2 rounded-full bg-brand px-2 py-0.5 text-xs font-semibold text-white">
              Shorts
            </span>
          )
        }
      </div>
      <div class="p-4">
        <h3 class="line-clamp-2 font-semibold leading-snug group-hover/card:text-brand-accent">
          {video.title}
          <span class="sr-only">(YouTube・新しいタブで開きます)</span>
        </h3>
        <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
          <time datetime={video.publishedAt}>{formatDateJa(video.publishedAt)}</time>
          <span class="rounded-full bg-surface px-2 py-0.5 text-xs">
            {CATEGORY_LABELS[category]}
          </span>
          {viewCountLabel && <span>{viewCountLabel}視聴</span>}
        </p>
      </div>
    </a>
    {
      gearItems.length > 0 && (
        <p class="mt-auto border-t border-line/60 px-4 py-3 text-xs text-ink-muted">
          紹介ガジェット: {gearItems.map((item) => gearDisplayName(item)).join("、")}{" "}
          <a
            href="/gear/"
            class="font-semibold text-brand-accent hover:underline focus-visible:outline-2 focus-visible:outline-brand"
          >
            愛用ガジェットで見る<span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </div>
  <PreviewButton
    videoId={video.id}
    title={video.title}
    aspect={video.isShort ? "short" : "video"}
  />
  <ShareButton title={video.title} url={videoUrl(video)} />
  <WatchLaterButton
    videoId={video.id}
    title={video.title}
    aspect={video.isShort ? "short" : "video"}
  />
</li>
