---
import { noteUrl, site, subscribeUrl } from "../config/site";
import SectionHeading from "./SectionHeading.astro";
---

<section aria-labelledby="profile-heading" class="py-16">
  <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center">
    <div>
      <p class="mb-3 text-sm font-bold text-brand-accent">ABOUT</p>
      <SectionHeading id="profile-heading" title="つくっている人" />
      <div class="relative w-fit">
        <div
          class="absolute -right-3 -bottom-3 h-full w-full rounded-full bg-brand"
          aria-hidden="true"
        >
        </div>
        <img
          src={site.profile.image}
          alt={site.profile.name}
          width="320"
          height="320"
          loading="lazy"
          decoding="async"
          class="relative aspect-square w-40 rounded-full border-4 border-surface-sun object-cover sm:w-52"
        />
      </div>
    </div>
    <div>
      <h3 class="text-3xl font-black">{site.profile.name}</h3>
      <p class="mt-2 font-semibold text-accent">{site.profile.role}</p>
      <p class="mt-6 max-w-3xl leading-loose">{site.profile.bio}</p>
      <ul role="list" class="mt-7 grid max-w-xl gap-4 text-sm font-semibold sm:grid-cols-2">
        <li>
          <a
            href={subscribeUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 w-full items-center justify-center rounded-md border px-4 py-3 text-center transition border-transparent bg-brand text-white hover:bg-brand-strong"
          >
            チャンネル登録する
            <span class="sr-only">(新しいタブで開きます)</span>
          </a>
        </li>
        <li>
          <a
            href={site.youtube.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 w-full items-center justify-center rounded-md border px-4 py-3 text-center transition border-ink hover:bg-surface"
          >
            YouTube: {site.youtube.handle}
            <span class="sr-only">(新しいタブで開きます)</span>
          </a>
        </li>
        <li>
          <a
            href={site.x.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 w-full items-center justify-center rounded-md border px-4 py-3 text-center transition border-ink hover:bg-surface"
          >
            X: @{site.x.account}
            <span class="sr-only">(新しいタブで開きます)</span>
          </a>
        </li>
        <li>
          <a
            href={noteUrl("profile")}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 w-full items-center justify-center rounded-md border px-4 py-3 text-center transition border-ink hover:bg-surface"
          >
            note: AI・技術ニュース
            <span class="sr-only">(新しいタブで開きます)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
