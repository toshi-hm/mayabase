---
/**
 * 新着動画公開時のプッシュ通知(#157)の購読/解除トグルボタン。
 *
 * ビルド時に `PUBLIC_VAPID_PUBLIC_KEY` が設定されていない場合は何も出力しない
 * (バックエンド未セットアップの環境でボタンだけが表示され、押しても機能しない状態を避ける)。
 * 設定されていても、Service Worker / PushManager / Notification API 未対応の
 * ブラウザではクライアント側で hidden のままにする(SiteHeader.astro に配置)。
 */
const vapidPublicKey = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY as string | undefined;
---

{
  vapidPublicKey && (
    <button
      type="button"
      id="push-notification-toggle"
      hidden
      aria-pressed="false"
      aria-label="新着動画のプッシュ通知を受け取る"
      data-vapid-public-key={vapidPublicKey}
      class="inline-flex flex-none cursor-pointer items-center justify-center rounded-full border border-ink-muted p-2 text-ink-muted transition hover:border-ink hover:bg-surface-raised hover:text-ink focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-wait disabled:opacity-60"
    >
      {/* 未購読時(デフォルト): アウトラインの鈴アイコン */}
      <svg
        data-push-icon="off"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
      </svg>
      {/* 購読中: 塗りつぶしの鈴アイコン */}
      <svg
        data-push-icon="on"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        class="hidden"
      >
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
      </svg>
      <span id="push-notification-status" class="sr-only" role="status" aria-live="polite"></span>
    </button>
  )
}

<script>
  import { urlBase64ToUint8Array } from "../lib/push";

  const SW_URL = "/sw.js";

  const button = document.getElementById("push-notification-toggle") as HTMLButtonElement | null;
  const vapidPublicKey = button?.dataset.vapidPublicKey;
  const status = document.getElementById("push-notification-status");

  function setStatus(message: string): void {
    if (status) status.textContent = message;
  }
  const supported =
    "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;

  function applyState(subscribed: boolean): void {
    button?.setAttribute("aria-pressed", String(subscribed));
    button?.setAttribute(
      "aria-label",
      subscribed ? "新着動画のプッシュ通知をオフにする" : "新着動画のプッシュ通知を受け取る",
    );
    for (const icon of button?.querySelectorAll<SVGElement>("[data-push-icon]") ?? []) {
      icon.classList.toggle("hidden", icon.dataset.pushIcon !== (subscribed ? "on" : "off"));
    }
  }

  async function postJson(path: string, body: unknown): Promise<boolean> {
    try {
      const response = await fetch(path, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      return response.ok;
    } catch {
      return false;
    }
  }

  if (button && supported && vapidPublicKey) {
    navigator.serviceWorker
      .register(SW_URL)
      .then(async (registration) => {
        const subscription = await registration.pushManager.getSubscription();
        applyState(Boolean(subscription));
        button.hidden = false;
      })
      .catch(() => {
        // Service Worker登録に失敗した環境ではボタン自体を出さない
      });

    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        const registration = await navigator.serviceWorker.ready;
        const existing = await registration.pushManager.getSubscription();

        if (existing) {
          const endpoint = existing.endpoint;
          const removedFromServer = await postJson("/api/push/unsubscribe", { endpoint });
          if (!removedFromServer) {
            applyState(true);
            setStatus("通知の解除に失敗しました。時間を置いてもう一度お試しください。");
            return;
          }

          let unsubscribed = false;
          try {
            unsubscribed = await existing.unsubscribe();
          } catch {
            // ブラウザ側の購読解除に失敗した場合は状態をオンのままにして再試行できるようにする
          }
          applyState(!unsubscribed);
          setStatus(
            unsubscribed
              ? "新着動画の通知をオフにしました。"
              : "サーバーからは解除しましたが、ブラウザ側の解除に失敗しました。もう一度お試しください。",
          );
          return;
        }

        const permission = await Notification.requestPermission();
        if (permission !== "granted") return;

        const subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapidPublicKey) as BufferSource,
        });
        const saved = await postJson("/api/push/subscribe", subscription.toJSON());
        if (!saved) {
          let rollbackSucceeded = false;
          try {
            rollbackSucceeded = await subscription.unsubscribe();
          } catch {
            // ロールバックに失敗した場合は、実際の購読状態に合わせてオンのままにする
          }
          applyState(!rollbackSucceeded);
          setStatus(
            rollbackSucceeded
              ? "通知の購読に失敗しました。時間を置いてもう一度お試しください。"
              : "通知の保存と購読解除に失敗しました。ブラウザの通知設定を確認してください。",
          );
          return;
        }
        applyState(true);
        setStatus("新着動画の通知をオンにしました。");
      } catch (error) {
        setStatus("通知設定の切り替えに失敗しました。時間を置いてもう一度お試しください。");
        console.warn("[push] 通知設定の切り替えに失敗しました:", error);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
