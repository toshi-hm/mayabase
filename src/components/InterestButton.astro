---
interface Props {
  videoId: string;
}
const { videoId } = Astro.props;
---

<button
  type="button"
  data-interest-video-id={videoId}
  aria-label="気になるに追加"
  class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-ink-muted transition hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-brand"
>
  気になる <span data-interest-count>0</span>
  <span
    data-interest-popular-badge
    hidden
    class="ml-1 rounded-full bg-brand/10 px-1.5 py-0.5 text-[10px] font-bold text-brand-accent"
  >
    話題
  </span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-interest-video-id]")) {
    button.addEventListener("click", async () => {
      const videoId = button.dataset.interestVideoId;
      if (!videoId || button.disabled) return;
      button.disabled = true;
      try {
        const response = await fetch("/api/video-reaction", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ videoId }),
        });
        if (!response.ok) return;
        const data = (await response.json()) as { count?: unknown };
        const count = typeof data.count === "number" ? data.count : 0;
        const countEl = button.querySelector("[data-interest-count]");
        if (countEl) countEl.textContent = String(count);
        button.setAttribute("aria-label", "気になる " + count + "件");
        const badge = button.querySelector<HTMLElement>("[data-interest-popular-badge]");
        const isPopular = count >= 10;
        if (isPopular) {
          button.dataset.interestPopular = "true";
        } else {
          delete button.dataset.interestPopular;
        }
        if (badge) badge.hidden = !isPopular;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
