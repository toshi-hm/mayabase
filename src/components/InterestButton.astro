---
interface Props {
  videoId: string;
  /** サムネイルのアスペクト比。Shorts の縦型サムネイル(ShortCard)は "short" を指定する */
  aspect?: "video" | "short";
}
const { videoId, aspect = "video" } = Astro.props;
---

{
  /* 親要素(カード全体)は視聴リンクの <a> のため、PreviewButton/WatchLaterButton と同じく
  入れ子のインタラクティブ要素(a > button)を避けて兄弟要素として重ねて配置する。
  aspect="video"(ArchiveCard/VideoCard)は尺表示がbottom-leftにあるため唯一空いている
  下部中央に配置する。以前は配置指定が無く裸のインライン要素としてカード本体の下にはみ出しており、
  カルーセル(embla, overflow:hidden)では実際に表示すらされていなかった(#393)。
  aspect="short"(ShortCard)は尺表示が無くbottom-leftが空いているが、モバイル実測(~140px)では
  テキスト付きピルのままだと bottom-right の WatchLaterButton(h-9 w-9)と依然として重なるため
  (レビュー指摘)、WatchLaterButton と同じ h-9 w-9 の円形バッジ(件数のみ表示)に縮小した上で
  bottom-leftへ配置する。件数の桁数が増えても幅が変わらないため再発しない。 */
}
<div
  class:list={[
    "pointer-events-none absolute inset-x-0 top-0 z-10 flex items-end p-2",
    aspect === "short" ? "justify-start aspect-[9/16]" : "justify-center aspect-video",
  ]}
>
  {
    aspect === "short" ? (
      // テキストラベルを付けると幅が入り切らないため、件数のみを表示する円形バッジにする
      // (WatchLaterButton と同じ h-9 w-9 で、件数が増えても大きさが変わらず重ならない)
      <button
        type="button"
        data-interest-video-id={videoId}
        aria-label="気になるに追加"
        class="pointer-events-auto relative grid h-9 w-9 cursor-pointer place-items-center rounded-full border border-line bg-surface/95 text-xs font-bold text-ink-muted backdrop-blur transition hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-brand"
      >
        <span data-interest-count aria-live="polite">
          0
        </span>
        <span
          data-interest-popular-badge
          hidden
          aria-hidden="true"
          class="absolute -top-1 -right-1 h-3 w-3 rounded-full border border-surface bg-brand-accent"
        />
      </button>
    ) : (
      <button
        type="button"
        data-interest-video-id={videoId}
        aria-label="気になるに追加"
        class="pointer-events-auto cursor-pointer rounded-full border border-line bg-surface/95 px-3 py-1 text-xs font-semibold text-ink-muted backdrop-blur transition hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-brand"
      >
        気になる{" "}
        <span data-interest-count aria-live="polite">
          0
        </span>
        <span
          data-interest-popular-badge
          hidden
          class="ml-1 rounded-full bg-brand/10 px-1.5 py-0.5 text-[10px] font-bold text-brand-accent"
        >
          話題
        </span>
      </button>
    )
  }
</div>

<script>
  const requestVersions = new WeakMap<HTMLButtonElement, number>();

  // 静的プレビューにはWorker APIがないため、Lighthouse/ローカル確認時の不要な404を避ける。
  const isStaticPreview = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);

  const applyCount = (button: HTMLButtonElement, count: number) => {
    const countEl = button.querySelector("[data-interest-count]");
    if (countEl) countEl.textContent = String(count);
    button.setAttribute("aria-label", "気になる " + count + "件");
    const badge = button.querySelector<HTMLElement>("[data-interest-popular-badge]");
    const isPopular = count >= 10;
    if (isPopular) {
      button.dataset.interestPopular = "true";
    } else {
      delete button.dataset.interestPopular;
    }
    if (badge) badge.hidden = !isPopular;
  };

  // 同じ動画のボタンがページ内に複数存在する場合(例: トップページの「はじめての方へ」と
  // 「あなたにおすすめ診断」に同じfeatured動画が重複して表示されるケース)、片方の操作結果を
  // 全インスタンスへ反映する(#394: 件数が同期しなかったバグ修正)。
  const applyCountToVideo = (videoId: string, count: number) => {
    document
      .querySelectorAll<HTMLButtonElement>(`[data-interest-video-id="${CSS.escape(videoId)}"]`)
      .forEach((button) => applyCount(button, count));
  };

  const loadCount = async (button: HTMLButtonElement, videoId: string) => {
    const version = requestVersions.get(button) ?? 0;
    try {
      const response = await fetch("/api/video-reaction?videoId=" + encodeURIComponent(videoId));
      if (!response.ok) return;
      const data = (await response.json()) as { count?: unknown };
      if (typeof data.count === "number" && requestVersions.get(button) === version) {
        applyCountToVideo(videoId, data.count);
      }
    } catch {
      // Initial count is best-effort and must not block the viewing experience.
    }
  };

  const scheduleCountLoad = (button: HTMLButtonElement, videoId: string) => {
    if (isStaticPreview) return;
    if (!("IntersectionObserver" in window)) {
      void loadCount(button, videoId);
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void loadCount(button, videoId);
      },
      { rootMargin: "200px" },
    );
    observer.observe(button);
  };

  const initializeButton = (button: HTMLButtonElement) => {
    if (button.dataset.interestInitialized === "true") return;
    const videoId = button.dataset.interestVideoId;
    if (!videoId) return;
    button.dataset.interestInitialized = "true";
    scheduleCountLoad(button, videoId);
  };

  const submitReaction = async (button: HTMLButtonElement) => {
    const videoId = button.dataset.interestVideoId;
    if (!videoId || button.disabled) return;
    const version = (requestVersions.get(button) ?? 0) + 1;
    requestVersions.set(button, version);
    button.disabled = true;
    try {
      const response = await fetch("/api/video-reaction", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ videoId }),
      });
      if (!response.ok) return;
      const data = (await response.json()) as { count?: unknown };
      if (typeof data.count === "number" && requestVersions.get(button) === version) {
        applyCountToVideo(videoId, data.count);
      }
    } finally {
      button.disabled = false;
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-interest-video-id]")
    .forEach(initializeButton);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>("[data-interest-video-id]");
    if (button) void submitReaction(button);
  });

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (!(node instanceof Element)) continue;
        if (node instanceof HTMLButtonElement && node.matches("[data-interest-video-id]")) {
          initializeButton(node);
        }
        node.querySelectorAll("[data-interest-video-id]").forEach((candidate) => {
          if (candidate instanceof HTMLButtonElement) initializeButton(candidate);
        });
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>
