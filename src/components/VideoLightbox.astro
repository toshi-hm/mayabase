---
/**
 * サイト内でのオンサイト・プレビュー再生用ライトボックス(#69)。
 * Base.astro に 1 つだけ配置し、各カードの PreviewButton.astro(data-lightbox-video-id 属性)
 * からのクリックをこのコンポーネントのスクリプトが拾って開閉を制御する。
 * ネイティブ <dialog> の showModal() を使うことで、Esc キーでの close・フォーカストラップ・
 * 開いた要素へのフォーカス復帰を自前実装せずに得られる。
 */
import { site, subscribeUrl } from "../config/site";
---

<dialog
  id="video-lightbox"
  aria-labelledby="video-lightbox-title"
  class="video-lightbox m-auto w-[min(56rem,92vw)] max-w-none rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl backdrop:bg-black/70"
>
  <div
    class="flex items-center justify-between gap-4 border-b border-line px-4 py-3"
  >
    <div class="min-w-0">
      <h2
        id="video-lightbox-title"
        class="line-clamp-1 text-sm font-semibold sm:text-base"
      >
      </h2>
      <p id="video-lightbox-queue-status" hidden class="text-xs text-ink-muted">
      </p>
    </div>
    <button
      type="button"
      data-lightbox-close
      aria-label="プレビューを閉じる"
      class="shrink-0 cursor-pointer rounded-full p-2 text-ink-muted transition hover:bg-surface-raised hover:text-ink focus-visible:outline-2 focus-visible:outline-brand"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <div id="video-lightbox-player" class="aspect-video w-full bg-black">
    <iframe
      id="video-lightbox-iframe"
      src=""
      title=""
      class="h-full w-full"
      allow="autoplay; encrypted-media; picture-in-picture; web-share"
      allowfullscreen></iframe>
  </div>
  {
    /* プレビュー再生に集中してもらいつつ、視聴後(あるいは視聴中)にそのまま登録に進める
    導線を用意する(#326)。動画本編の視聴に対して控えめな見た目に留める。 */
  }
  <div
    class="flex items-center justify-between gap-4 border-t border-line px-4 py-3"
  >
    <p class="text-sm text-ink-muted">{site.name}が気に入ったら</p>
    <a
      href={subscribeUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-none rounded-full bg-brand px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-brand-strong focus-visible:outline-2 focus-visible:outline-brand"
    >
      チャンネル登録する <span aria-hidden="true">↗</span>
      <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
    </a>
  </div>
</dialog>

<script>
  import {
    buildLightboxSrc,
    getLightboxContainerClass,
    parseLightboxAspect,
    parseLightboxStartSeconds,
  } from "../lib/lightbox";
  import {
    createVisibleVideoQueue,
    nextVideoInQueue,
    parseVideoQueue,
    type VideoQueueItem,
  } from "../lib/videoQueue";

  interface LightboxYouTubePlayerStateChangeEvent {
    data: number;
  }
  interface LightboxYouTubePlayer {
    destroy: () => void;
  }
  interface LightboxYouTubeIframeApi {
    Player: new (
      element: HTMLIFrameElement,
      options: {
        events: {
          onStateChange: (event: LightboxYouTubePlayerStateChangeEvent) => void;
        };
      },
    ) => LightboxYouTubePlayer;
    PlayerState: { ENDED: number };
  }
  type LightboxWindow = Window & {
    YT?: LightboxYouTubeIframeApi;
    onYouTubeIframeAPIReady?: () => void;
  };
  const browserWindow = window as LightboxWindow;

  const dialog = document.getElementById("video-lightbox");
  const player = document.getElementById("video-lightbox-player");
  const iframeElement = document.getElementById("video-lightbox-iframe");
  const titleEl = document.getElementById("video-lightbox-title");
  const queueStatusEl = document.getElementById("video-lightbox-queue-status");
  const closeButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-lightbox-close]",
  );

  if (
    dialog instanceof HTMLDialogElement &&
    player &&
    iframeElement instanceof HTMLIFrameElement &&
    titleEl &&
    queueStatusEl &&
    closeButton
  ) {
    let iframe = iframeElement;
    let activeQueue: VideoQueueItem[] = [];
    let activeVideoId = "";
    let youtubePlayer: LightboxYouTubePlayer | null = null;
    let youtubeApiPromise: Promise<LightboxYouTubeIframeApi> | null = null;
    let openGeneration = 0;

    const loadYouTubeApi = (): Promise<LightboxYouTubeIframeApi> => {
      if (browserWindow.YT) return Promise.resolve(browserWindow.YT);
      if (youtubeApiPromise) return youtubeApiPromise;
      youtubeApiPromise = new Promise<LightboxYouTubeIframeApi>(
        (resolve, reject) => {
          const previousReady = browserWindow.onYouTubeIframeAPIReady;
          browserWindow.onYouTubeIframeAPIReady = () => {
            previousReady?.();
            if (browserWindow.YT) resolve(browserWindow.YT);
            else reject(new Error("YouTube IFrame API is unavailable"));
          };
          const apiScript = document.createElement("script");
          apiScript.src = "https://www.youtube.com/iframe_api";
          apiScript.onerror = () =>
            reject(new Error("YouTube IFrame API failed to load"));
          document.head.appendChild(apiScript);
        },
      );
      return youtubeApiPromise;
    };

    const updateQueueStatus = (): void => {
      const index = activeQueue.findIndex((item) => item.id === activeVideoId);
      if (index < 0 || activeQueue.length < 2) {
        queueStatusEl.hidden = true;
        queueStatusEl.textContent = "";
        return;
      }
      queueStatusEl.hidden = false;
      queueStatusEl.textContent = `一気見 ${index + 1} / ${activeQueue.length}`;
    };

    const getVisibleQueue = (
      queueRoot: HTMLElement | null,
    ): VideoQueueItem[] => {
      if (!queueRoot) return [];
      return createVisibleVideoQueue(
        [
          ...queueRoot.querySelectorAll<HTMLElement>("[data-lightbox-video-id]"),
        ]
          .map((trigger) => ({
            id: trigger.dataset.lightboxVideoId ?? "",
            title: trigger.dataset.lightboxTitle ?? "",
            aspect:
              trigger.dataset.lightboxAspect === "short" ? "short" : "video",
            hidden: trigger.closest<HTMLElement>("li")?.hidden ?? false,
          }))
          .filter((item) => item.id && item.title),
      );
    };

    const attachPlayer = async (generation: number): Promise<void> => {
      if (activeQueue.length < 2) return;
      try {
        const YT = await loadYouTubeApi();
        if (
          !dialog.open ||
          generation !== openGeneration ||
          !activeQueue.length
        )
          return;
        youtubePlayer = new YT.Player(iframe, {
          events: {
            onStateChange: (event) => {
              if (event.data !== YT.PlayerState.ENDED) return;
              const next = nextVideoInQueue(activeQueue, activeVideoId);
              if (next)
                openLightbox(
                  next.id,
                  next.title,
                  next.aspect,
                  undefined,
                  activeQueue,
                );
            },
          },
        });
      } catch {
        // APIが読み込めない場合は現在の動画だけ再生し、通常の閉じる操作を維持する。
      }
    };

    const openLightbox = (
      videoId: string,
      title: string,
      aspect: string | undefined,
      startSeconds: string | undefined,
      queue: VideoQueueItem[] = [],
    ): void => {
      youtubePlayer?.destroy();
      youtubePlayer = null;
      const nextIframe = document.createElement("iframe");
      nextIframe.id = "video-lightbox-iframe";
      nextIframe.className = "h-full w-full";
      nextIframe.allow =
        "autoplay; encrypted-media; picture-in-picture; web-share";
      nextIframe.allowFullscreen = true;
      if (iframe.isConnected) iframe.replaceWith(nextIframe);
      else player.append(nextIframe);
      iframe = nextIframe;
      openGeneration += 1;
      activeQueue = queue;
      activeVideoId = videoId;
      player.className = getLightboxContainerClass(parseLightboxAspect(aspect));
      const url = new URL(
        buildLightboxSrc(videoId, parseLightboxStartSeconds(startSeconds)),
      );
      url.searchParams.set("enablejsapi", "1");
      url.searchParams.set("origin", browserWindow.location.origin);
      iframe.src = url.toString();
      iframe.title = title;
      titleEl.textContent = title;
      updateQueueStatus();
      if (!dialog.open) dialog.showModal();
      void attachPlayer(openGeneration);
    };

    const closeLightbox = (): void => {
      if (dialog.open) dialog.close();
    };

    dialog.addEventListener("close", () => {
      youtubePlayer?.destroy();
      youtubePlayer = null;
      activeQueue = [];
      activeVideoId = "";
      openGeneration += 1;
      iframe.src = "";
      iframe.title = "";
      titleEl.textContent = "";
      queueStatusEl.hidden = true;
      queueStatusEl.textContent = "";
    });

    closeButton.addEventListener("click", closeLightbox);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeLightbox();
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-lightbox-video-id]");
      if (!trigger) return;
      const videoId = trigger.dataset.lightboxVideoId;
      if (!videoId) return;
      const queueRoot = trigger.closest<HTMLElement>("[data-binge-queue]");
      const queue = getVisibleQueue(queueRoot).length
        ? getVisibleQueue(queueRoot)
        : parseVideoQueue(queueRoot?.dataset.bingeQueue);
      openLightbox(
        videoId,
        trigger.dataset.lightboxTitle ?? "",
        trigger.dataset.lightboxAspect,
        trigger.dataset.lightboxStart,
        queue,
      );
    });
  }
</script>

<style>
  .video-lightbox[open] {
    animation: video-lightbox-in 200ms ease-out both;
  }

  @keyframes video-lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-lightbox[open] {
      animation: none;
    }
  }
</style>
