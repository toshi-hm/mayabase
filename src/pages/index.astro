---
import ArchiveCard from "../components/ArchiveCard.astro";
import Carousel from "../components/Carousel.astro";
import PostCard from "../components/PostCard.astro";
import Profile from "../components/Profile.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ShortCard from "../components/ShortCard.astro";
import VideoCard from "../components/VideoCard.astro";
import { site, subscribeUrl } from "../config/site";
import channelStatsJson from "../data/channel-stats.json";
import featuredVideosJson from "../data/featured-videos.json";
import videosJson from "../data/videos.json";
import xPostsJson from "../data/x-posts.json";
import Base from "../layouts/Base.astro";
import {
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  categorizeVideo,
  categoryUrl,
  topVideosByCategory,
} from "../lib/categories";
import {
  formatFetchedAt,
  formatSubscriberCount,
  nextSubscriberMilestone,
  parseChannelStats,
} from "../lib/channelStats";
import { parseFeaturedVideosData, resolveFeaturedVideos } from "../lib/featuredVideos";
import { extractSearchableText, formatViewCount, truncate } from "../lib/format";
import { computeUpdateFrequencyLabel } from "../lib/updateFrequency";
import { parseXPostsData } from "../lib/x";
import {
  embedUrl,
  parseVideosData,
  thumbnailFallbackUrl,
  thumbnailUrl,
  type Video,
  videoUrl,
} from "../lib/youtube";

const { maxItems } = site.carousel;
const { videos } = parseVideosData(videosJson);

// isShort: null(未判定)は横動画として表示する(docs/02-design.md)
const regularVideos = videos.filter((v) => v.isShort !== true).slice(0, maxItems);
const shortVideos = videos.filter((v) => v.isShort === true).slice(0, maxItems);

// 運営者が手動でキュレーションする代表動画。未設定(空配列)ならセクションごと非表示にする
const { featuredVideoIds } = parseFeaturedVideosData(featuredVideosJson);
const featuredVideos = resolveFeaturedVideos(featuredVideoIds, videos).slice(0, maxItems);

// 再生回数上位の動画(#35)。RSSのみ(YOUTUBE_API_KEY未設定)の環境では再生回数が
// 取得できないため、1件も取得できていなければセクション自体を非表示にする
// (subscriberCount と同様のフォールバック方針)。
const popularVideos = videos
  .filter((v): v is Video & { viewCount: number } => v.viewCount !== null)
  .sort((a, b) => b.viewCount - a.viewCount)
  .slice(0, maxItems);

const { account, posts } = parseXPostsData(xPostsJson);
const xPosts = posts.slice(0, maxItems);

// 初回訪問者向け「気になるテーマは?」導線(#156)。カテゴリ別静的アーカイブページ(#121)と
// 役割が重複しないよう、ここでは各カテゴリの上位動画のみを紹介し、全件は
// /videos/category/{category}/ へ誘導する(入口の分岐に留める)。
// "other" は「気になるテーマ」として提示する分類ではないため対象外とする。
// 4テーマ分をあらかじめ全件DOMに描画する(初期非表示分は #videos-grid と同じ方針)ため、
// 他セクションの maxItems(6)より少ない件数に絞り、ページ全体のDOMサイズ増加を抑える。
const TOPIC_PANEL_LIMIT = 4;
const categorized = videos.map((video) => ({ video, category: categorizeVideo(video) }));
const topicPanels = CATEGORY_ORDER.filter((category) => category !== "other")
  .map((category) => ({
    category,
    videos: topVideosByCategory(categorized, category, TOPIC_PANEL_LIMIT),
  }))
  .filter((panel) => panel.videos.length > 0);

// 未取得(API キー未設定・取得失敗・非公開設定)の場合は null のまま非表示にする
const { subscriberCount, viewCount, fetchedAt } = parseChannelStats(channelStatsJson);
const subscriberText = subscriberCount !== null ? formatSubscriberCount(subscriberCount) : null;
// チャンネル総再生回数(#60)。登録者数と同じフォールバック方針で、未取得時は非表示にする
const totalViewCountText = viewCount !== null ? formatViewCount(viewCount) : null;
// 次のマイルストーン(#200)。目標値は常に計算値のため、運用コストなしで最新の目標を維持できる。
// 登録者数を取得できない環境(subscriberCount === null)では既存方針どおり非表示にする。
const nextMilestoneText =
  subscriberCount !== null ? formatSubscriberCount(nextSubscriberMilestone(subscriberCount)) : null;
const milestoneRemainingText =
  subscriberCount !== null
    ? formatSubscriberCount(nextSubscriberMilestone(subscriberCount) - subscriberCount)
    : null;
// リアルタイム取得ではないため、取得日時を併記する
const fetchedAtText = fetchedAt !== null ? formatFetchedAt(fetchedAt) : null;

// 更新頻度の目安(#187)。初回訪問者が登録を判断する材料として提示する。
// データ不足・ペースが低すぎる・間隔が不規則、のいずれかの場合は算出結果を出さない
// (subscriberCount 等と同じ「取得できなければ非表示」の方針)。
const updateFrequencyText = computeUpdateFrequencyLabel(videos);

// JSON-LD 構造化データ(VideoObject は Google 必須の name / description / thumbnailUrl / uploadDate を含む)
if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const displayedVideos = [...regularVideos, ...shortVideos];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: site.name,
      description: site.description,
      url: siteUrl,
      inLanguage: "ja",
      publisher: { "@id": `${siteUrl}#owner` },
      // Google のサイトリンク検索ボックス用(/videos/ の ?q= はキーワード検索と同期済み)
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}videos/?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#owner`,
      name: site.profile.name,
      description: site.profile.bio,
      url: siteUrl,
      sameAs: [site.youtube.url, site.x.url],
    },
    // 動画一覧の記述用(遷移先は youtube.com のためホストカルーセル要件の対象外)
    ...(displayedVideos.length > 0
      ? [
          {
            "@type": "ItemList",
            "@id": `${siteUrl}#videos`,
            name: `${site.name} の最新動画`,
            isPartOf: { "@id": `${siteUrl}#website` },
            itemListElement: displayedVideos.map((video, index) => ({
              "@type": "ListItem",
              position: index + 1,
              item: {
                "@type": "VideoObject",
                name: video.title,
                // 概要欄全文はハッシュタグや定型文が長く JSON-LD を肥大化させるため要約する(videos.astro と同じ方針)。
                // 冒頭の署名欄ハッシュタグはノイズでしかないため、要約前に除外する(#125)
                description: truncate(extractSearchableText(video.description), 160) || video.title,
                thumbnailUrl: [thumbnailUrl(video.id), thumbnailFallbackUrl(video.id)],
                uploadDate: video.publishedAt,
                embedUrl: embedUrl(video.id),
                url: videoUrl(video),
              },
            })),
          },
        ]
      : []),
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base>
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main">
    <section aria-labelledby="videos-heading" class="overflow-hidden border-b border-line pb-14">
      <div class="mx-auto max-w-6xl px-4 pt-8 sm:pt-10">
        <div class="mb-8 grid gap-5 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
          <div>
            <p class="mb-2 text-sm font-bold text-brand-accent">ITで日常をより便利に</p>
            <h1 class="text-4xl font-black sm:text-6xl">{site.name}</h1>
            {
              (subscriberText || totalViewCountText) && (
                <p class="mt-2 text-sm font-semibold text-ink-muted">
                  {subscriberText && (
                    <>
                      チャンネル登録者数 <span class="text-ink">{subscriberText}</span>
                    </>
                  )}
                  {subscriberText && totalViewCountText && " / "}
                  {totalViewCountText && (
                    <>
                      総再生回数 <span class="text-ink">{totalViewCountText}</span>
                    </>
                  )}
                  {fetchedAtText && ` (${fetchedAtText})`}
                </p>
              )
            }
            {
              subscriberText && nextMilestoneText && milestoneRemainingText && (
                <p class="mt-1 text-sm font-semibold text-brand-accent">
                  次の目標({nextMilestoneText})まであと{milestoneRemainingText}!
                </p>
              )
            }
          </div>
          <div class="lg:pb-1">
            <p class="leading-relaxed text-ink-muted">
              AI、ガジェット、働く日々のリアル。暮らしと仕事を少し便利にする発見を動画で届けます。
            </p>
            {
              updateFrequencyText && (
                <p class="mt-2 text-sm font-semibold text-ink-muted">
                  更新頻度の目安 <span class="text-ink">{updateFrequencyText}</span>
                </p>
              )
            }
            <nav
              aria-label="チャンネルリンク"
              class="mt-4 flex flex-wrap gap-4 text-sm font-semibold"
            >
              <a
                href={subscribeUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md bg-brand px-4 py-2 text-white transition hover:bg-brand-strong"
              >
                チャンネル登録する <span aria-hidden="true">↗</span>
                <span class="sr-only">(新しいタブで開きます)</span>
              </a>
              <a
                href={site.youtube.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-1 py-2 underline decoration-line underline-offset-4 hover:text-brand-accent"
              >
                YouTube で見る
                <span class="sr-only">(新しいタブで開きます)</span>
              </a>
              <a
                href="/videos/"
                class="px-1 py-2 underline decoration-line underline-offset-4 hover:text-brand-accent"
              >
                すべての動画
              </a>
            </nav>
          </div>
        </div>
        <div class="mb-5 flex items-end justify-between gap-4 border-t border-line pt-5">
          <h2 id="videos-heading" class="text-xl font-black sm:text-2xl">最新動画</h2>
          <p class="hidden text-sm text-ink-muted sm:block">NEW RELEASES</p>
        </div>
        {
          regularVideos.length > 0 ? (
            <Carousel label="最新動画の一覧">
              {regularVideos.map((video, index) => (
                <VideoCard
                  video={video}
                  position={index + 1}
                  total={regularVideos.length}
                  eager={index === 0}
                  featured
                />
              ))}
            </Carousel>
          ) : (
            <p class="rounded-lg bg-surface-raised p-8 text-center text-ink-muted">
              動画データを準備中です。
              <a
                href={site.youtube.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent underline underline-offset-4"
              >
                YouTube チャンネル
                <span class="sr-only">(新しいタブで開きます)</span>
              </a>
              で最新の動画をご覧ください。
            </p>
          )
        }
      </div>
    </section>

    {
      topicPanels.length > 0 && (
        <section aria-labelledby="topic-picker-heading" class="py-16">
          <div class="mx-auto max-w-6xl px-4">
            <SectionHeading
              id="topic-picker-heading"
              title="気になるテーマは?"
              subtitle="興味のあるテーマを選ぶと、おすすめの動画をすぐにチェックできます。"
            />
            <div role="group" aria-label="テーマを選ぶ" class="flex flex-wrap gap-2">
              {topicPanels.map(({ category }) => (
                <a
                  href={categoryUrl(category)}
                  role="button"
                  data-topic-category={category}
                  aria-pressed="false"
                  class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
                >
                  {CATEGORY_LABELS[category]}
                </a>
              ))}
            </div>
            <div id="topic-picker-results" class="mt-6" hidden>
              <p id="topic-picker-count" aria-live="polite" class="mb-4 text-sm text-ink-muted" />
              {topicPanels.map(({ category, videos: panelVideos }) => (
                <div data-topic-panel={category} hidden>
                  <ul role="list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {panelVideos.map((video) => (
                      <ArchiveCard video={video} category={category} />
                    ))}
                  </ul>
                  <a
                    href={categoryUrl(category)}
                    class="mt-6 inline-block text-sm font-semibold text-brand hover:underline"
                  >
                    {CATEGORY_LABELS[category]}の動画をすべて見る
                  </a>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      featuredVideos.length > 0 && (
        <section aria-labelledby="featured-heading" class="bg-surface-sun py-16">
          <div class="mx-auto max-w-6xl px-4">
            <SectionHeading
              id="featured-heading"
              title="はじめての方へ"
              subtitle="まずはこの動画から。チャンネルの雰囲気をチェックしてみてください。"
            />
            <Carousel label="はじめての方へのおすすめ動画">
              {featuredVideos.map((video, index) => (
                <VideoCard video={video} position={index + 1} total={featuredVideos.length} />
              ))}
            </Carousel>
          </div>
        </section>
      )
    }

    {
      popularVideos.length > 0 && (
        <section aria-labelledby="popular-heading" class="bg-surface-raised py-16">
          <div class="mx-auto max-w-6xl px-4">
            <SectionHeading
              id="popular-heading"
              title="人気動画"
              subtitle="視聴回数の多い動画から、チャンネルの世界観をチェック。"
            />
            <Carousel label="人気動画の一覧">
              {popularVideos.map((video, index) => (
                <VideoCard
                  video={video}
                  position={index + 1}
                  total={popularVideos.length}
                  viewCountLabel={formatViewCount(video.viewCount)}
                />
              ))}
            </Carousel>
          </div>
        </section>
      )
    }

    <section aria-labelledby="shorts-heading" class="bg-surface-mint py-16">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading
          id="shorts-heading"
          title="Shortsで、さっと発見"
          subtitle="移動中や休憩時間にも見やすい、短いアイデアと気づきをまとめました。"
        />
        {
          shortVideos.length > 0 ? (
            <Carousel label="Shorts の一覧">
              {shortVideos.map((video, index) => (
                <ShortCard video={video} position={index + 1} total={shortVideos.length} />
              ))}
            </Carousel>
          ) : (
            <p class="rounded-xl bg-surface-raised p-8 text-center text-ink-muted">
              Shorts データを準備中です。
              <a
                href={site.youtube.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent underline underline-offset-4"
              >
                YouTube チャンネル
                <span class="sr-only">(新しいタブで開きます)</span>
              </a>
              でご覧ください。
            </p>
          )
        }
      </div>
    </section>

    <section aria-labelledby="x-heading" class="py-16">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading
          id="x-heading"
          title="いま考えていること"
          subtitle={`@${account} から、動画になる前の気づきや日々の記録を。`}
        />
        {
          xPosts.length > 0 ? (
            <Carousel label="X ポストの一覧">
              {xPosts.map((post, index) => (
                <PostCard
                  post={post}
                  account={account}
                  position={index + 1}
                  total={xPosts.length}
                />
              ))}
            </Carousel>
          ) : (
            <p class="rounded-xl bg-surface-raised p-8 text-center text-ink-muted">
              ポストデータを準備中です。
              <a
                href={site.x.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent underline underline-offset-4"
              >
                X(@{account})<span class="sr-only">(新しいタブで開きます)</span>
              </a>
              で最新の投稿をご覧ください。
            </p>
          )
        }
      </div>
    </section>

    <section class="bg-surface-sun">
      <div class="mx-auto max-w-6xl px-4">
        <Profile />
      </div>
    </section>
  </main>
</Base>

<script>
  // 「気になるテーマは?」導線(#156)。テーマボタンは /videos/category/{category}/ への
  // 実リンクを兼ねる(role="button" の <a>、videos.astro のカテゴリチップと同じパターン)。
  // JS 無効時・クローラーはそのままカテゴリ別静的ページへ遷移/到達できる。
  const buttons = document.querySelectorAll<HTMLAnchorElement>("[data-topic-category]");
  const results = document.getElementById("topic-picker-results");
  const countLabel = document.getElementById("topic-picker-count");
  const panels = document.querySelectorAll<HTMLDivElement>("[data-topic-panel]");

  function selectTopic(category: string, label: string): void {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.topicCategory === category));
    }
    let selectedPanel: HTMLDivElement | null = null;
    for (const panel of panels) {
      const isMatch = panel.dataset.topicPanel === category;
      panel.hidden = !isMatch;
      if (isMatch) selectedPanel = panel;
    }
    if (results) results.hidden = false;
    if (countLabel) {
      const videoCount = selectedPanel?.querySelector("ul")?.children.length ?? 0;
      countLabel.textContent = `${label}のおすすめ動画 ${videoCount} 件`;
    }
    // 絞り込み結果の先頭カードへフォーカスを移す(videos.astro の「もっと見る」と同じ方針)
    selectedPanel?.querySelector("a")?.focus();
  }

  for (const button of buttons) {
    button.addEventListener("click", (event) => {
      // 修飾キー付きクリック・中クリックはブラウザ標準の「新しいタブで開く」に任せる
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) {
        return;
      }
      const category = button.dataset.topicCategory;
      if (!category) return;
      event.preventDefault();
      selectTopic(category, button.textContent?.trim() ?? "");
    });
    // role="button" の <a> は Space キーでの activate に対応しないため、button と同じ操作性にする
    button.addEventListener("keydown", (event) => {
      if (event.key === " ") {
        event.preventDefault();
        button.click();
      }
    });
  }
</script>
