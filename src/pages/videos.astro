---
import ArchiveCard from "../components/ArchiveCard.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { site } from "../config/site";
import gearJson from "../data/gear.json";
import videosJson from "../data/videos.json";
import Base from "../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../lib/breadcrumb";
import {
  categoryUrl,
  CATEGORY_LABELS,
  categorizeVideo,
  getAvailableCategories,
} from "../lib/categories";
import { extractSearchableText, truncate } from "../lib/format";
import { buildVideoGearMap, parseGearData } from "../lib/gear";
import {
  embedUrl,
  parseVideosData,
  thumbnailFallbackUrl,
  thumbnailUrl,
  videoUrl,
} from "../lib/youtube";

const { videos } = parseVideosData(videosJson);
const categorized = videos.map((video) => ({ video, category: categorizeVideo(video) }));
// 動画側から「紹介ガジェット」を表示するための逆引きマップ(#70)
const { items: gearItems } = parseGearData(gearJson);
const videoGearMap = buildVideoGearMap(gearItems);
const INITIAL_COUNT = 12;
const LOCAL_THUMBNAILS: Partial<Record<string, string>> = {
  "2WX26Bekrfk": "/images/videos-first-thumbnail.webp",
};
const firstThumbnailSrc = videos[0]
  ? (LOCAL_THUMBNAILS[videos[0].id] ?? thumbnailFallbackUrl(videos[0].id))
  : undefined;

// 動画が 1 件以上あるカテゴリだけをフィルタ UI に出す(カテゴリ別静的ページと同じ方針・#121)
const availableCategories = getAvailableCategories(categorized);

// 再生回数ソートのトグル(#48)。RSS のみ(YOUTUBE_API_KEY 未設定)の環境では
// 全動画の viewCount が null になるため、1 件も取得できていなければトグル自体を非表示にする
// (index.astro の popularVideos / subscriberCount と同じフォールバック方針)
const hasViewCounts = videos.some((video) => video.viewCount !== null);

const pageTitle = `動画ライブラリ | ${site.name}`;
const pageDescription = `${site.name} の全動画アーカイブ。AI・ガジェット/家電・社会人 Vlog・エンジニアキャリアのカテゴリやキーワードから過去の動画を探せます。`;

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "動画ライブラリ", href: "/videos/" },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}videos/#videos`,
      name: `${site.name} の動画一覧`,
      itemListElement: videos.map((video, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "VideoObject",
          name: video.title,
          // 概要欄全文はハッシュタグや定型文が長く JSON-LD を肥大化させるため要約する。
          // 冒頭の署名欄ハッシュタグはノイズでしかないため、要約前に除外する(#125)
          description: truncate(extractSearchableText(video.description), 160) || video.title,
          thumbnailUrl: [thumbnailUrl(video.id), thumbnailFallbackUrl(video.id)],
          uploadDate: video.publishedAt,
          embedUrl: embedUrl(video.id),
          url: videoUrl(video),
        },
      })),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
// 概要欄検索用データはカード属性ではなく 1 つの JSON に集約し、カード DOM を軽く保つ。
const searchableDescriptionsSafe = JSON.stringify(
  Object.fromEntries(
    videos.map((video) => [video.id, extractSearchableText(video.description).toLowerCase()]),
  ),
).replace(/</g, "\\u003c");
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImagePath="/ogp-videos.png"
  ogImageAlt={`${site.name} 動画ライブラリ`}
>
  {
    firstThumbnailSrc && (
      <link rel="preload" as="image" href={firstThumbnailSrc} fetchpriority="high" slot="head" />
    )
  }
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <script
    is:inline
    id="video-search-descriptions"
    type="application/json"
    set:html={searchableDescriptionsSafe}
  />
  <main id="main" class="mx-auto max-w-6xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="text-3xl font-bold sm:text-4xl">動画ライブラリ</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      これまでに公開した全 {videos.length}
      本の動画アーカイブです。カテゴリやキーワードで気になる動画を探して、YouTube でご覧ください。
    </p>

    <section aria-label="動画の絞り込み" class="mt-8 flex flex-col gap-4">
      <div role="group" aria-label="カテゴリで絞り込み" class="flex flex-wrap gap-2">
        <button
          type="button"
          data-filter-category="all"
          aria-pressed="true"
          class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
        >
          すべて
        </button>
        {
          /* カテゴリチップは、クライアントサイド絞り込みのトグルボタンであると同時に、
          カテゴリ別静的ページ(/videos/category/{category}/)への実リンクでもある(#121)。
          JS 有効時はクリックを後述のスクリプトが preventDefault してこのページ内で絞り込み、
          JS 無効時・クローラーはそのままリンク先の静的ページへ遷移/到達できる。
          role="button" によりトグルボタンとしての aria-pressed を有効な組み合わせにする。 */
        }
        {
          availableCategories.map((category) => (
            <a
              href={categoryUrl(category)}
              role="button"
              data-filter-category={category}
              aria-pressed="false"
              class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
            >
              {CATEGORY_LABELS[category]}
            </a>
          ))
        }
      </div>
      {
        hasViewCounts && (
          <div role="group" aria-label="並び替え" class="flex flex-wrap gap-2">
            <button
              type="button"
              data-sort-order="newest"
              aria-pressed="true"
              class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
            >
              新しい順
            </button>
            <button
              type="button"
              data-sort-order="popular"
              aria-pressed="false"
              class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
            >
              人気順
            </button>
          </div>
        )
      }
      <div class="max-w-md">
        <label for="video-search" class="mb-1 block text-sm text-ink-muted">キーワード検索</label>
        <input
          id="video-search"
          type="search"
          placeholder="例: ChatGPT、家電、Vlog"
          class="w-full rounded-xl border border-ink-muted bg-surface-raised px-4 py-2 placeholder:text-ink-muted/60 focus-visible:outline-2 focus-visible:outline-brand"
        />
      </div>
      <p id="videos-count" aria-live="polite" class="text-sm text-ink-muted">
        {videos.length} 件
      </p>
    </section>

    {/* 見出し階層(h1→h2→h3)を保つためのセクション見出し(視覚上はフィルタ UI が境界) */}
    <h2 class="sr-only">動画一覧</h2>
    <ul
      id="videos-grid"
      data-initial-count={INITIAL_COUNT}
      role="list"
      class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        categorized.map(({ video, category }, index) => (
          <ArchiveCard
            video={video}
            category={category}
            eager={index === 0}
            thumbnailSrc={index === 0 ? firstThumbnailSrc : undefined}
            initiallyHidden={index >= INITIAL_COUNT}
            gearItems={videoGearMap.get(video.id) ?? []}
          />
        ))
      }
    </ul>
    {
      /* JS 無効時は絞り込みスクリプトが動かないため、初期非表示のカードを含めて全件表示にフォールバックする。
      <noscript> はスクリプト無効時のみ適用されるため、JS 有効時の絞り込み・段階表示には影響しない
      (ArchiveCard.astro のコメント参照: `hidden` 属性ではなく data-initial-hidden を上書きする)。 */
    }
    <noscript>
      <style>
        #videos-grid > li[data-initial-hidden="true"] {
          display: block !important;
        }
      </style>
    </noscript>
    <p id="videos-empty" hidden class="rounded-xl bg-surface-raised p-8 text-center text-ink-muted">
      条件に一致する動画が見つかりませんでした。カテゴリやキーワードを変えてお試しください。
    </p>
    {
      /*
      「もっと見る」ボタン。JS 有効時のみスクリプトが必要に応じて表示する。
      一度押すと以降は全件表示のまま(このボタンは二度と表示されない)。
    */
    }
    <div class="mt-10 text-center">
      <button
        id="videos-more"
        type="button"
        hidden
        class="cursor-pointer rounded-full border border-ink-muted px-8 py-3 font-semibold transition hover:border-ink hover:bg-surface-raised focus-visible:outline-2 focus-visible:outline-brand"
      >
        もっと見る
      </button>
    </div>
  </main>
</Base>

<script>
  // 絞り込み・検索 + 段階表示
  import { textMatchesKeyword } from "../lib/format";

  const grid = document.getElementById("videos-grid");
  // サーバー側(videos.astro のフロントマター)の値を data 属性経由で受け取り、二重定義を避ける
  const INITIAL_COUNT = Number(grid?.dataset.initialCount) || 12;
  // 「すべて」は button、各カテゴリチップはカテゴリページへの実リンクを兼ねる a 要素(#121)
  const buttons = document.querySelectorAll<HTMLButtonElement | HTMLAnchorElement>(
    "[data-filter-category]",
  );
  const sortButtons = document.querySelectorAll<HTMLButtonElement>("[data-sort-order]");
  const search = document.getElementById("video-search") as HTMLInputElement | null;
  // 「新しい順」に戻す際に再利用する元の DOM 順(= videos.json の公開日時降順)を保持しておく。
  // 並び替え後は appendChild でカードを移動するだけなので、この配列自体の中身(要素参照)は不変。
  const originalOrder = [...document.querySelectorAll<HTMLLIElement>("#videos-grid > li")];
  // applyFilter が参照する「現在の表示順」。並び替え時に reorderGrid() が差し替える。
  let cards: HTMLLIElement[] = originalOrder;
  const descriptionsElement = document.getElementById("video-search-descriptions");
  const descriptions: Record<string, string> = descriptionsElement?.textContent
    ? JSON.parse(descriptionsElement.textContent)
    : {};
  const count = document.getElementById("videos-count");
  const empty = document.getElementById("videos-empty");
  const moreButton = document.getElementById("videos-more") as HTMLButtonElement | null;
  let category = "all";
  // 並び替え状態(#152: category/q と同じくURLに同期する)
  let sortOrder: "newest" | "popular" = "newest";
  // 一度展開したら以降は全件表示のまま(ボタンは二度と出さない)
  let expanded = false;

  // サーバーが inline style(display:none)で隠していた初期非表示カードを解放し、
  // 以降は hidden 属性(applyFilter)のみで表示状態を制御する
  // (inline style は <noscript> フォールバック専用。ArchiveCard.astro のコメント参照)
  for (const card of cards) {
    card.style.removeProperty("display");
  }

  // URL 経由で受け取ってよいカテゴリ値(ボタンが実際に持つ値のみ許可し、任意の入力は信用しない)
  const validCategories = new Set(
    [...buttons].map((button) => button.dataset.filterCategory ?? "all"),
  );

  function setPressedCategory(nextCategory: string): void {
    for (const button of buttons) {
      button.setAttribute(
        "aria-pressed",
        String((button.dataset.filterCategory ?? "all") === nextCategory),
      );
    }
  }

  function setPressedSortOrder(nextOrder: "newest" | "popular"): void {
    for (const button of sortButtons) {
      const buttonOrder = button.dataset.sortOrder === "popular" ? "popular" : "newest";
      button.setAttribute("aria-pressed", String(buttonOrder === nextOrder));
    }
  }

  // クエリパラメータ(category / q / order)から絞り込み・並び替え状態を復元する。
  // 不正な category / order 値はそれぞれの既定値にフォールバックする(任意の入力を信用しない)。
  // expanded(「もっと見る」展開状態)はURLに含めていないため、popstate 時は常に未展開に戻す
  // (でないと戻る操作後もカテゴリ変更前の全件展開表示が残ってしまう)。
  function restoreStateFromUrl(): void {
    expanded = false;
    const params = new URLSearchParams(location.search);
    const urlCategory = params.get("category");
    category = urlCategory && validCategories.has(urlCategory) ? urlCategory : "all";
    setPressedCategory(category);
    if (search) search.value = params.get("q") ?? "";

    // 並び替えトグル自体が無い環境(viewCount 未取得)では order パラメータを無視する
    if (sortButtons.length > 0) {
      sortOrder = params.get("order") === "popular" ? "popular" : "newest";
      setPressedSortOrder(sortOrder);
      reorderGrid(sortOrder);
    }
  }

  // 現在の絞り込み・並び替え状態を URL クエリパラメータへ反映する。
  // デフォルト値(category=all・空検索・order=newest)はパラメータごと省略し URL をきれいに保つ。
  // mode "push": 独立した履歴エントリを作る(戻るボタンで直前の状態に戻れるようにする)
  // mode "replace": 現在の履歴エントリを書き換えるのみ(入力のたびに履歴を汚さない)
  function syncUrl(mode: "push" | "replace"): void {
    const params = new URLSearchParams();
    if (category !== "all") params.set("category", category);
    const query = (search?.value ?? "").trim();
    if (query) params.set("q", query);
    if (sortOrder !== "newest") params.set("order", sortOrder);
    const queryString = params.toString();
    const newUrl = `${location.pathname}${queryString ? `?${queryString}` : ""}${location.hash}`;
    if (mode === "push") {
      history.pushState(null, "", newUrl);
    } else {
      history.replaceState(null, "", newUrl);
    }
  }

  function cardMatches(card: HTMLLIElement, query: string): boolean {
    return (
      (category === "all" || card.dataset.category === category) &&
      (textMatchesKeyword(card.dataset.title ?? "", query) ||
        textMatchesKeyword(descriptions[card.dataset.videoId ?? ""] ?? "", query))
    );
  }

  function applyFilter(): void {
    const query = (search?.value ?? "").trim().toLowerCase();
    let matched = 0; // 条件に一致する総数
    let shown = 0; // 実際に表示している数(未展開時は INITIAL_COUNT で頭打ち)
    for (const card of cards) {
      if (cardMatches(card, query)) {
        matched += 1;
        const withinLimit = expanded || matched <= INITIAL_COUNT;
        card.hidden = !withinLimit;
        if (withinLimit) shown += 1;
      } else {
        card.hidden = true;
      }
    }
    if (count) count.textContent = `${matched} 件`;
    if (empty) empty.hidden = matched > 0;

    const remaining = matched - shown;
    if (moreButton) {
      if (!expanded && remaining > 0) {
        moreButton.hidden = false;
        moreButton.textContent = `もっと見る(残り ${remaining} 件)`;
      } else {
        moreButton.hidden = true;
      }
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", (event) => {
      // 修飾キー付きクリック・中クリックはブラウザ標準の「新しいタブで開く」に任せる
      // (カテゴリチップは /videos/category/{category}/ への実リンクを兼ねるため)。
      if (
        button instanceof HTMLAnchorElement &&
        event instanceof MouseEvent &&
        (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey)
      ) {
        return;
      }
      // カテゴリチップは実リンク(<a href>)を兼ねる。JS 有効時はページ遷移させず、
      // 既存のクライアントサイド絞り込み体験(このページ内での即時絞り込み)を維持する(#121)。
      event.preventDefault();
      category = button.dataset.filterCategory ?? "all";
      setPressedCategory(category);
      applyFilter();
      // カテゴリ変更は独立した絞り込み状態とみなし、戻るボタンで前のカテゴリに戻れるよう履歴を1件積む
      syncUrl("push");
    });
    // role="button" の <a> はネイティブでは Space キーでの activate に対応しないため、
    // button と同じ操作性になるよう Space キーでもクリック相当の動作をさせる。
    button.addEventListener("keydown", (event) => {
      if (
        button instanceof HTMLAnchorElement &&
        event instanceof KeyboardEvent &&
        event.key === " "
      ) {
        event.preventDefault();
        button.click();
      }
    });
  }
  search?.addEventListener("input", () => {
    applyFilter();
    // 入力のたびに履歴エントリを増やすとブラウザ履歴がスパムになるため、現在のエントリを上書きする
    syncUrl("replace");
  });

  // 再生回数ベースの並び替え(#48)。viewCount が 1 件も無い環境ではトグル自体が
  // レンダリングされない(videos.astro のフロントマター参照)ため sortButtons は空になる。
  function getViewCount(card: HTMLLIElement): number {
    const raw = card.dataset.viewCount;
    if (!raw) return -1; // 未取得の動画は「人気順」で最下位に回す
    const parsed = Number(raw);
    return Number.isFinite(parsed) ? parsed : -1;
  }

  // カードを DOM 上で並び替える(appendChild は既存ノードの移動であり、
  // 複製ではないため、状態やイベントリスナーはそのまま保たれる)
  function reorderGrid(order: "newest" | "popular"): void {
    const sorted =
      order === "popular"
        ? [...originalOrder].sort((a, b) => getViewCount(b) - getViewCount(a))
        : originalOrder;
    for (const card of sorted) {
      grid?.appendChild(card);
    }
    cards = sorted;
  }

  for (const button of sortButtons) {
    button.addEventListener("click", () => {
      sortOrder = button.dataset.sortOrder === "popular" ? "popular" : "newest";
      setPressedSortOrder(sortOrder);
      reorderGrid(sortOrder);
      applyFilter();
      // 並び替えもカテゴリと同様、独立した状態変化とみなし履歴を1件積む
      syncUrl("push");
    });
  }

  moreButton?.addEventListener("click", () => {
    // 展開直前に「これから現れる最初のカード」を控えておき、展開後にフォーカスを移す
    const query = (search?.value ?? "").trim().toLowerCase();
    const firstRevealed = [...cards].find((card) => card.hidden && cardMatches(card, query));
    expanded = true;
    applyFilter();
    firstRevealed?.querySelector("a")?.focus();
  });

  // 戻る/進むボタン操作時は URL から絞り込み状態を再構築する
  window.addEventListener("popstate", () => {
    restoreStateFromUrl();
    applyFilter();
  });

  // 初期表示:URL のクエリパラメータから絞り込み状態を復元してから表示する
  // (件数が INITIAL_COUNT を超えていれば頭打ち + ボタン表示)
  restoreStateFromUrl();
  applyFilter();
</script>
