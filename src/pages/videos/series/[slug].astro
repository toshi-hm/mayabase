---
import ArchiveCard from "../../../components/ArchiveCard.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { site } from "../../../config/site";
import gearJson from "../../../data/gear.json";
import seriesJson from "../../../data/series.json";
import videosJson from "../../../data/videos.json";
import Base from "../../../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../../../lib/breadcrumb";
import { categorizeVideo } from "../../../lib/categories";
import { extractSearchableText, truncate } from "../../../lib/format";
import { buildVideoGearMap, parseGearData } from "../../../lib/gear";
import { isInSeries, parseSeriesData, type SeriesItem, seriesUrl } from "../../../lib/series";
import {
  embedUrl,
  parseVideosData,
  thumbnailFallbackUrl,
  thumbnailUrl,
  type Video,
  videoUrl,
} from "../../../lib/youtube";

export function getStaticPaths() {
  const { series } = parseSeriesData(seriesJson);
  const { videos } = parseVideosData(videosJson);
  // series.json に定義された各シリーズについて、キーワードに該当する動画を抽出する(#174 を汎用化・#250)
  return series.map((item) => ({
    params: { slug: item.slug },
    props: {
      series: item,
      seriesVideos: videos.filter((video) => isInSeries(video, item.keyword)),
    },
  }));
}

interface Props {
  series: SeriesItem;
  seriesVideos: Video[];
}

const { series, seriesVideos }: Props = Astro.props;

// 愛用ガジェットとの相互リンク(videos.astro と同じ #70)
const { items: gearItems } = parseGearData(gearJson);
const videoGearMap = buildVideoGearMap(gearItems);

// 先頭カード(eager)の画像は onerror フォールバックの直列リクエストを避けるため、
// 存在保証のある hqdefault を直接指定する(ArchiveCard.astro の eager 分岐と同じ方針)。
const firstThumbnailSrc = seriesVideos[0] ? thumbnailFallbackUrl(seriesVideos[0].id) : undefined;

const pageTitle = `${series.title} 動画一覧 | ${site.name}`;
const pageDescription = `${series.description}${seriesVideos.length} 本のアーカイブです。`;

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "動画ライブラリ", href: "/videos/" },
  { name: series.title, href: seriesUrl(series.slug) },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}videos/series/${series.slug}/#videos`,
      name: `${site.name} の${series.title}動画一覧`,
      itemListElement: seriesVideos.map((video, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "VideoObject",
          name: video.title,
          // 概要欄全文はハッシュタグや定型文が長く JSON-LD を肥大化させるため要約する(#125 と同じ方針)
          description: truncate(extractSearchableText(video.description), 160) || video.title,
          thumbnailUrl: [thumbnailUrl(video.id), thumbnailFallbackUrl(video.id)],
          uploadDate: video.publishedAt,
          embedUrl: embedUrl(video.id),
          url: videoUrl(video),
          // Google 推奨プロパティ。取得できない動画は省略する(#173)
          ...(video.duration !== null && { duration: video.duration }),
        },
      })),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImagePath="/ogp-videos.png"
  ogImageAlt={`${site.name} ${series.title} 動画一覧`}
>
  {
    firstThumbnailSrc && (
      <link rel="preload" as="image" href={firstThumbnailSrc} fetchpriority="high" slot="head" />
    )
  }
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main" class="mx-auto max-w-6xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="text-3xl font-bold sm:text-4xl">{series.title}</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      {series.description}
      カテゴリを横断して {seriesVideos.length}
      本の動画をまとめてチェックできます。
    </p>

    <nav aria-label="動画ライブラリへ戻る" class="mt-8 flex flex-wrap gap-2">
      <a
        href="/videos/"
        class="rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand"
      >
        すべての動画を見る
      </a>
    </nav>

    <h2 class="sr-only">{series.title}の動画一覧</h2>
    <ul role="list" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        seriesVideos.map((video, index) => (
          <ArchiveCard
            video={video}
            category={categorizeVideo(video)}
            eager={index === 0}
            thumbnailSrc={index === 0 ? firstThumbnailSrc : undefined}
            gearItems={videoGearMap.get(video.id) ?? []}
          />
        ))
      }
    </ul>
  </main>
</Base>
