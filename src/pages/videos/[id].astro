---
import Breadcrumb from "../../components/Breadcrumb.astro";
import GearMiniCard from "../../components/GearMiniCard.astro";
import RelatedVideoCard from "../../components/RelatedVideoCard.astro";
import ShareButton from "../../components/ShareButton.astro";
import WatchLaterButton from "../../components/WatchLaterButton.astro";
import { site, subscribeUrl } from "../../config/site";
import gearJson from "../../data/gear.json";
import videosJson from "../../data/videos.json";
import Base from "../../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../../lib/breadcrumb";
import { CATEGORY_LABELS, categorizeVideo } from "../../lib/categories";
import { formatChapterTime, parseChapters } from "../../lib/chapters";
import {
  extractSearchableText,
  formatDateJa,
  formatViewCount,
  linkifyText,
  truncate,
} from "../../lib/format";
import { buildVideoGearMap, parseGearData, type GearItem } from "../../lib/gear";
import { getLightboxContainerClass } from "../../lib/lightbox";
import { getAdjacentVideos, getRelatedVideos } from "../../lib/relatedVideos";
import {
  buildPlayerCardMeta,
  embedUrl,
  parseVideosData,
  resolveOgThumbnail,
  thumbnailFallbackUrl,
  thumbnailUrl,
  type Video,
  videoUrl,
  videoUrlAtTime,
} from "../../lib/youtube";

export function getStaticPaths() {
  const { videos } = parseVideosData(videosJson);
  // 動画 ID → 紹介ガジェット一覧の逆引きマップ(videos.astro と同じ方針・#134)。
  // 動画数だけページが生成されるため、マップの構築は getStaticPaths 側で 1 度だけ行う。
  const { items: gearItems } = parseGearData(gearJson);
  const videoGearMap = buildVideoGearMap(gearItems);
  return videos.map((video) => ({
    params: { id: video.id },
    props: { video, videos, gearItems: videoGearMap.get(video.id) ?? [] },
  }));
}

interface Props {
  video: Video;
  videos: Video[];
  /** この動画で紹介されているガジェット(愛用ガジェットとの相互リンク用・#134) */
  gearItems: GearItem[];
}

const { video, videos, gearItems } = Astro.props;
const category = categorizeVideo(video);
const RELATED_LIMIT = 6;
const relatedVideos = getRelatedVideos(video, videos, category, RELATED_LIMIT);
// 公開日時順の前後ナビゲーション(#106)。関連動画(同カテゴリ)とは別軸の発見導線。
const adjacentVideos = getAdjacentVideos(video, videos);
const viewCountText = video.viewCount !== null ? formatViewCount(video.viewCount) : null;
// 概要欄の段落(空行区切り)を保持したまま表示するため行単位に分割する
const descriptionParagraphs = video.description.split("\n");
// 概要欄にYouTubeのチャプター記法(0:00 見出し)があれば目次として表示する(#154)
const chapters = parseChapters(video.description);

// OGP画像は JSON-LD の thumbnailUrl と同じ「hq720優先・hqdefaultフォールバック」方針だが、
// meta タグ1本のみで配列を使えないため、ビルド時に存在確認済みの動画だけ高解像度を採用する(#211)
const ogThumbnail = resolveOgThumbnail(video);

const pageTitle = `${video.title} | ${site.name}`;
// meta description はハッシュタグ等を含む概要欄をそのまま出すと読みづらいため、
// 冒頭の署名欄ハッシュタグ・末尾の定型文を除いた本文相当部分を要約する(#125)
const pageDescription = truncate(extractSearchableText(video.description), 140) || video.title;
// X(Twitter) Player Card / og:video 用メタ。Shorts では null(#243)
const playerCardMeta = buildPlayerCardMeta(video);

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "動画ライブラリ", href: "/videos/" },
  { name: video.title, href: `/videos/${video.id}/` },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
    {
      "@type": "VideoObject",
      "@id": `${siteUrl}videos/${video.id}/#video`,
      name: video.title,
      // 概要欄全文はハッシュタグや定型文が長く JSON-LD を肥大化させるため要約する(videos.astro と同じ方針)。
      // 冒頭の署名欄ハッシュタグはノイズでしかないため、要約前に除外する(#125)
      description: truncate(extractSearchableText(video.description), 160) || video.title,
      thumbnailUrl: [thumbnailUrl(video.id), thumbnailFallbackUrl(video.id)],
      uploadDate: video.publishedAt,
      embedUrl: embedUrl(video.id),
      url: videoUrl(video),
      // Google 推奨プロパティ。ISO 8601 のまま出力できる(#173)。取得できない動画は省略する
      // (viewCount と同じ「取得できたものだけ表示」方針)。
      ...(video.duration !== null && { duration: video.duration }),
      // 検索結果でのキーモーメント表示を狙い、チャプターを Clip として構造化する(#154)
      ...(chapters.length > 0 && {
        hasPart: chapters.map((chapter) => ({
          "@type": "Clip",
          name: chapter.label,
          startOffset: chapter.seconds,
          url: videoUrlAtTime(video, chapter.seconds),
        })),
      }),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImagePath={ogThumbnail.url}
  ogImageAlt={video.title}
  ogImageWidth={ogThumbnail.width}
  ogImageHeight={ogThumbnail.height}
  videoPlayerUrl={playerCardMeta?.playerUrl}
  videoPlayerWidth={playerCardMeta?.width}
  videoPlayerHeight={playerCardMeta?.height}
>
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main" class="mx-auto max-w-4xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />

    <div class="relative">
      {
        /* このページの LCP 要素のため、存在保証のある hqdefault を直接使い、
        onerror フォールバックの直列リクエストによる遅延を避ける(VideoCard.astro と同じ方針) */
      }
      <img
        src={thumbnailFallbackUrl(video.id)}
        alt=""
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-video w-full rounded-xl bg-surface-raised object-cover"
      />
      {
        video.isShort && (
          <span class="absolute top-3 left-3 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">
            Shorts
          </span>
        )
      }
      <ShareButton title={video.title} url={videoUrl(video)} />
      <WatchLaterButton videoId={video.id} title={video.title} />
    </div>

    <h1 class="mt-6 text-2xl font-bold sm:text-3xl">{video.title}</h1>
    <p class="mt-3 flex flex-wrap items-center gap-3 text-sm text-ink-muted">
      <time datetime={video.publishedAt}>{formatDateJa(video.publishedAt)}</time>
      <span class="rounded-full bg-surface-raised px-3 py-1 text-xs font-semibold">
        {CATEGORY_LABELS[category]}
      </span>
      {viewCountText && <span>{viewCountText}視聴</span>}
    </p>

    <div class="mt-5 flex flex-wrap gap-3">
      <a
        href={videoUrl(video)}
        target="_blank"
        rel="noopener noreferrer"
        data-watch-track-id={video.id}
        class="rounded-full bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-strong"
      >
        YouTube で見る <span aria-hidden="true">↗</span>
        <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
      </a>
      <a
        href={subscribeUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-ink-muted px-6 py-3 font-semibold transition hover:border-ink hover:bg-surface-raised"
      >
        チャンネル登録する <span aria-hidden="true">↗</span>
        <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
      </a>
    </div>

    {/* サイト内プレビュー再生。個別ページのため直接埋め込みでライトボックス等は用いない(#83) */}
    <section aria-labelledby="preview-heading" class="mt-12">
      <h2 id="preview-heading" class="sr-only">動画プレビュー</h2>
      <div
        class:list={[
          "overflow-hidden rounded-xl",
          getLightboxContainerClass(video.isShort ? "short" : "video"),
        ]}
      >
        <iframe
          id="video-player-frame"
          src={embedUrl(video.id)}
          title={video.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="h-full w-full"></iframe>
      </div>
    </section>

    {
      chapters.length > 0 && (
        <section aria-labelledby="chapters-heading" class="mt-8">
          <h2 id="chapters-heading" class="text-xl font-bold">
            チャプター
          </h2>
          <ol role="list" class="mt-4 divide-y divide-line rounded-xl border border-line">
            {chapters.map((chapter) => (
              <li>
                <a
                  href={videoUrlAtTime(video, chapter.seconds)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-chapter-seconds={chapter.seconds}
                  class="flex items-center gap-4 px-4 py-3 transition hover:bg-surface-raised focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand"
                >
                  <span class="w-16 shrink-0 font-mono text-sm text-ink-muted tabular-nums">
                    {formatChapterTime(chapter.seconds)}
                  </span>
                  <span>
                    {chapter.label}
                    <span class="sr-only">(この位置から再生します)</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section aria-labelledby="description-heading" class="mt-12">
      <h2 id="description-heading" class="text-xl font-bold">概要</h2>
      <div class="mt-3 leading-relaxed text-ink-muted">
        {
          descriptionParagraphs.map((line) =>
            line === "" ? <br /> : <p set:html={linkifyText(line)} />,
          )
        }
      </div>
    </section>

    {
      /* 0 件なら非表示(featuredVideos/popularVideos・関連動画と同じ方針・#134) */
      gearItems.length > 0 && (
        <section aria-labelledby="gear-heading" class="mt-12">
          <h2 id="gear-heading" class="text-xl font-bold">
            この動画で紹介したガジェット
          </h2>
          <p class="mt-2 text-sm text-ink-muted">
            動画内で使用・紹介した機材です。ほかの愛用ガジェットは
            <a href="/gear/" class="font-semibold text-brand-accent hover:underline">
              愛用ガジェット
            </a>
            でまとめてチェックできます。
          </p>
          <ul role="list" class="mt-5 grid gap-3 sm:grid-cols-2">
            {gearItems.map((item) => (
              <GearMiniCard item={item} />
            ))}
          </ul>
        </section>
      )
    }

    {
      (adjacentVideos.older || adjacentVideos.newer) && (
        <nav
          aria-label="公開日順の前後ナビゲーション"
          class="mt-12 grid gap-3 border-t border-b border-line py-4 sm:grid-cols-2"
        >
          {adjacentVideos.older ? (
            <a
              href={`/videos/${adjacentVideos.older.id}/`}
              class="group/pager flex items-center gap-3 rounded-lg p-3 transition hover:bg-surface-raised focus-visible:outline-2 focus-visible:outline-brand"
            >
              <span aria-hidden="true" class="text-ink-muted">
                ←
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-ink-muted">前の動画</span>
                <span class="line-clamp-1 font-semibold group-hover/pager:text-brand-accent">
                  {adjacentVideos.older.title}
                </span>
              </span>
            </a>
          ) : (
            <span />
          )}
          {adjacentVideos.newer ? (
            <a
              href={`/videos/${adjacentVideos.newer.id}/`}
              class="group/pager flex items-center justify-end gap-3 rounded-lg p-3 text-right transition hover:bg-surface-raised focus-visible:outline-2 focus-visible:outline-brand sm:col-start-2"
            >
              <span class="min-w-0">
                <span class="block text-xs text-ink-muted">次の動画</span>
                <span class="line-clamp-1 font-semibold group-hover/pager:text-brand-accent">
                  {adjacentVideos.newer.title}
                </span>
              </span>
              <span aria-hidden="true" class="text-ink-muted">
                →
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {
      relatedVideos.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-16">
          <h2 id="related-heading" class="text-xl font-bold">
            関連動画
          </h2>
          <p class="mt-2 text-sm text-ink-muted">
            「{CATEGORY_LABELS[category]}」カテゴリの他の動画です。
          </p>
          <ul role="list" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedVideos.map((relatedVideo) => (
              <RelatedVideoCard video={relatedVideo} category={category} />
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="video-cta-heading" class="mt-16">
      <div class="rounded-2xl bg-surface-raised p-8 text-center">
        <h2 id="video-cta-heading" class="text-xl font-bold">もっと動画をチェックする</h2>
        <p class="mx-auto mt-2 max-w-xl text-ink-muted">
          {site.name} では AI・ガジェット・社会人 Vlog など幅広いテーマの動画を公開しています。
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <a
            href="/videos/"
            class="rounded-full bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-strong"
          >
            動画ライブラリを見る
          </a>
          <a
            href={subscribeUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink-muted px-6 py-3 font-semibold transition hover:border-ink hover:bg-surface"
          >
            チャンネル登録する <span aria-hidden="true">↗</span>
            <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // チャプターリンクは通常のYouTube視聴URLへのリンク(JS無効環境・クローラー向けフォールバック)。
  // JS有効時はページ遷移せず、埋め込みプレイヤーのiframeを該当秒数から再生し直す(#154)
  const frame = document.getElementById("video-player-frame");
  const chapterLinks = document.querySelectorAll<HTMLAnchorElement>("[data-chapter-seconds]");
  if (frame instanceof HTMLIFrameElement) {
    for (const link of chapterLinks) {
      link.addEventListener("click", (event) => {
        const seconds = link.dataset.chapterSeconds;
        if (!seconds) return;
        // 修飾キー(Ctrl/Cmd/Shift)クリックや中クリックはブラウザ標準の
        // 「新しいタブで開く」動作を優先し、iframe差し替えは行わない
        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) return;
        event.preventDefault();
        const url = new URL(frame.src);
        url.searchParams.set("start", seconds);
        url.searchParams.set("autoplay", "1");
        frame.src = url.toString();
        frame.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  }
</script>
