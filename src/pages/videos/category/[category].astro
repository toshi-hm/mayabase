---
import ArchiveCard from "../../../components/ArchiveCard.astro";
import ArchiveFilterController from "../../../components/ArchiveFilterController.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SubscribeMilestoneNote from "../../../components/SubscribeMilestoneNote.astro";
import { site, subscribeUrl } from "../../../config/site";
import gearJson from "../../../data/gear.json";
import videosJson from "../../../data/videos.json";
import Base from "../../../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../../../lib/breadcrumb";
import {
  CATEGORY_LABELS,
  categorizeVideo,
  categoryUrl,
  getAvailableCategories,
  type VideoCategory,
} from "../../../lib/categories";
import { extractSearchableText, truncate } from "../../../lib/format";
import { buildVideoGearMap, parseGearData } from "../../../lib/gear";
import {
  embedUrl,
  parseVideosData,
  thumbnailFallbackUrl,
  thumbnailUrl,
  type Video,
  videoUrl,
} from "../../../lib/youtube";

export function getStaticPaths() {
  const { videos } = parseVideosData(videosJson);
  const categorized = videos.map((video) => ({ video, category: categorizeVideo(video) }));
  // 動画が 1 件以上あるカテゴリだけページを生成する(videos.astro の availableCategories と同じ方針・#121)
  return getAvailableCategories(categorized).map((category) => ({
    params: { category },
    props: {
      category,
      categoryVideos: categorized
        .filter((entry) => entry.category === category)
        .map((entry) => entry.video),
    },
  }));
}

interface Props {
  category: VideoCategory;
  categoryVideos: Video[];
}

const { category, categoryVideos }: Props = Astro.props;
const categoryLabel = CATEGORY_LABELS[category];

// 愛用ガジェットとの相互リンク(videos.astro と同じ #70)
const { items: gearItems } = parseGearData(gearJson);
const videoGearMap = buildVideoGearMap(gearItems);

// 他のカテゴリへの内部リンク(全カテゴリ横断のページランク分散・回遊導線)
const { videos: allVideos } = parseVideosData(videosJson);
const allCategorized = allVideos.map((video) => ({ video, category: categorizeVideo(video) }));
const otherCategories = getAvailableCategories(allCategorized).filter((c) => c !== category);

// 先頭カード(eager)の画像は onerror フォールバックの直列リクエストを避けるため、
// 存在保証のある hqdefault を直接指定する(ArchiveCard.astro の eager 分岐と同じ方針)。
const firstThumbnailSrc = categoryVideos[0]
  ? thumbnailFallbackUrl(categoryVideos[0].id)
  : undefined;

const pageTitle = `${categoryLabel}の動画一覧 | ${site.name}`;
const pageDescription = `${site.name} の「${categoryLabel}」カテゴリの動画アーカイブ。${categoryVideos.length} 本の動画をまとめてチェックできます。`;

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "動画ライブラリ", href: "/videos/" },
  { name: categoryLabel, href: categoryUrl(category) },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}videos/category/${category}/#videos`,
      name: `${site.name} の「${categoryLabel}」動画一覧`,
      itemListElement: categoryVideos.map((video, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "VideoObject",
          name: video.title,
          // 概要欄全文はハッシュタグや定型文が長く JSON-LD を肥大化させるため要約する(videos.astro と同じ方針)。
          // 冒頭の署名欄ハッシュタグはノイズでしかないため、要約前に除外する(#125)
          description: truncate(extractSearchableText(video.description), 160) || video.title,
          thumbnailUrl: [thumbnailUrl(video.id), thumbnailFallbackUrl(video.id)],
          uploadDate: video.publishedAt,
          embedUrl: embedUrl(video.id),
          url: videoUrl(video),
          // Google 推奨プロパティ。取得できない動画は省略する(#173)
          ...(video.duration !== null && { duration: video.duration }),
        },
      })),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImagePath="/ogp-videos.png"
  ogImageAlt={`${site.name} ${categoryLabel}の動画一覧`}
>
  {
    firstThumbnailSrc && (
      <link rel="preload" as="image" href={firstThumbnailSrc} fetchpriority="high" slot="head" />
    )
  }
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${categoryLabel} | ${site.name}`}
    href={`/videos/category/${category}/rss.xml`}
    slot="head"
  />
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main" class="mx-auto max-w-6xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="text-3xl font-bold sm:text-4xl">{categoryLabel}の動画一覧</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      「{categoryLabel}」カテゴリの動画 {categoryVideos.length}
      本のアーカイブです。気になる動画を見つけて、YouTube でご覧ください。
    </p>
    <p class="mt-2 text-sm">
      <a
        href={`/videos/category/${category}/rss.xml`}
        class="inline-flex items-center gap-1 text-ink-muted underline-offset-4 transition hover:text-ink hover:underline"
      >
        「{categoryLabel}」の新着動画をRSSで購読
      </a>
    </p>

    {
      otherCategories.length > 0 && (
        <nav aria-label="他のカテゴリ" class="mt-8 flex flex-wrap gap-2">
          <a
            href="/videos/"
            class="rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand"
          >
            すべて
          </a>
          {otherCategories.map((c) => (
            <a
              href={categoryUrl(c)}
              class="rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand"
            >
              {CATEGORY_LABELS[c]}
            </a>
          ))}
        </nav>
      )
    }

    <section aria-label="動画の絞り込み" class="mt-6 flex flex-col gap-4">
      <div role="group" aria-label="動画の長さで絞り込み" class="flex flex-wrap gap-2">
        <button
          type="button"
          data-filter-length="all"
          aria-pressed="true"
          class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
        >
          すべて
        </button>
        <button
          type="button"
          data-filter-length="video"
          aria-pressed="false"
          class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
        >
          通常動画
        </button>
        <button
          type="button"
          data-filter-length="short"
          aria-pressed="false"
          class="cursor-pointer rounded-full border border-ink-muted px-4 py-1.5 text-sm transition hover:border-ink focus-visible:outline-2 focus-visible:outline-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-white"
        >
          Shorts
        </button>
      </div>
      <div class="max-w-md">
        <label for="archive-search" class="mb-1 block text-sm text-ink-muted">キーワード検索</label>
        <input
          id="archive-search"
          type="search"
          placeholder="例: ChatGPT、家電、Vlog"
          class="w-full rounded-xl border border-ink-muted bg-surface-raised px-4 py-2 placeholder:text-ink-muted/60 focus-visible:outline-2 focus-visible:outline-brand"
        />
      </div>
      <p id="archive-count" aria-live="polite" class="text-sm text-ink-muted">
        {categoryVideos.length} 件
      </p>
    </section>

    <h2 class="sr-only">{categoryLabel}の動画一覧</h2>
    <ul id="archive-grid" role="list" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        categoryVideos.map((video, index) => (
          <ArchiveCard
            video={video}
            category={category}
            eager={index === 0}
            thumbnailSrc={index === 0 ? firstThumbnailSrc : undefined}
            gearItems={videoGearMap.get(video.id) ?? []}
          />
        ))
      }
    </ul>
    <p
      id="archive-empty"
      hidden
      class="mt-6 rounded-xl bg-surface-raised p-8 text-center text-ink-muted"
    >
      条件に一致する動画が見つかりませんでした。キーワードを変えてお試しください。
    </p>

    <section aria-labelledby="category-cta-heading" class="pt-16">
      <div class="rounded-2xl bg-surface-raised p-8 text-center">
        <h2 id="category-cta-heading" class="text-xl font-bold">
          もっと{site.name}の動画を見たい方は
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-ink-muted">
          チャンネル登録すると、新着動画の通知を受け取れます。
        </p>
        <SubscribeMilestoneNote />
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <a
            href={subscribeUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-strong"
          >
            チャンネル登録する <span aria-hidden="true">↗</span>
            <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
          </a>
          <a
            href={site.youtube.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink-muted px-6 py-3 font-semibold transition hover:border-ink hover:bg-surface"
          >
            YouTube チャンネルへ <span aria-hidden="true">↗</span>
            <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  {/* 動画の長さ・キーワードでの絞り込み(#275)。DOM は持たずスクリプトのみ */}
  <ArchiveFilterController />
</Base>
