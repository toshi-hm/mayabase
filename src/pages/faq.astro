---
import Breadcrumb from "../components/Breadcrumb.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../config/site";
import faqJson from "../data/faq.json";
import Base from "../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../lib/breadcrumb";
import { isInternalPath, parseFaqData } from "../lib/faq";

const { categories } = parseFaqData(faqJson);
const allItems = categories.flatMap((category) => category.items);

const pageTitle = `よくある質問 | ${site.name}`;
const pageDescription = `${site.name} へのよくある質問。チャンネルの内容、運営者プロフィール、使用機材、お仕事のご依頼方法についてまとめています。`;

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "よくある質問", href: "/faq/" },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}faq/#faq`,
      mainEntity: allItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main" class="mx-auto max-w-3xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="text-3xl font-bold sm:text-4xl">よくある質問</h1>
    <p class="mt-3 text-ink-muted">
      チャンネルや運営者、機材、お仕事のご依頼についてよくいただく質問をまとめました。
    </p>

    <section aria-label="よくある質問の絞り込み" class="mt-6 max-w-md">
      <label for="faq-search" class="mb-1 block text-sm text-ink-muted">キーワード検索</label>
      <input
        id="faq-search"
        type="search"
        placeholder="例: 機材、お仕事、プロフィール"
        class="w-full rounded-xl border border-ink-muted bg-surface-raised px-4 py-2 placeholder:text-ink-muted/60 focus-visible:outline-2 focus-visible:outline-brand"
      />
      <p id="faq-count" aria-live="polite" class="mt-2 text-sm text-ink-muted">
        {allItems.length} 件
      </p>
    </section>

    {
      categories.map((category, categoryIndex) => (
        <section
          aria-labelledby={`faq-category-${categoryIndex}-heading`}
          class="pt-12"
          data-faq-section
        >
          <SectionHeading id={`faq-category-${categoryIndex}-heading`} title={category.title} />
          <div class="flex flex-col gap-3">
            {category.items.map((item) => (
              <details
                class="group rounded-xl bg-surface-raised"
                data-faq-item
                data-question={item.question.toLowerCase()}
                data-answer={item.answer.toLowerCase()}
              >
                <summary class="cursor-pointer list-none rounded-xl p-5 font-semibold transition hover:text-brand focus-visible:outline-2 focus-visible:outline-brand [&::-webkit-details-marker]:hidden">
                  <span class="flex items-start justify-between gap-4">
                    {item.question}
                    <span
                      aria-hidden="true"
                      class="flex-none text-ink-muted transition group-open:rotate-45"
                    >
                      +
                    </span>
                  </span>
                </summary>
                <div class="px-5 pb-5">
                  <p class="leading-relaxed text-ink-muted">{item.answer}</p>
                  {item.link &&
                    (isInternalPath(item.link.url) ? (
                      <a
                        href={item.link.url}
                        class="mt-3 inline-block text-brand underline-offset-4 hover:underline"
                      >
                        {item.link.label}
                      </a>
                    ) : (
                      <a
                        href={item.link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-3 inline-block text-brand underline-offset-4 hover:underline"
                      >
                        {item.link.label}
                        <span class="sr-only">(外部サイト・新しいタブで開きます)</span>
                      </a>
                    ))}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
    <p
      id="faq-empty"
      hidden
      class="mt-8 rounded-xl bg-surface-raised p-8 text-center text-ink-muted"
    >
      条件に一致する質問が見つかりませんでした。キーワードを変えてお試しください。
    </p>

    <section aria-labelledby="faq-cta-heading" class="pt-16">
      <div class="rounded-2xl bg-surface-raised p-8 text-center">
        <h2 id="faq-cta-heading" class="text-xl font-bold">解決しない質問がありますか?</h2>
        <p class="mx-auto mt-2 max-w-xl text-ink-muted">
          マシュマロで匿名の質問を受け付けています。いただいた質問には動画のネタとしてお答えします。
        </p>
        <div class="mt-5">
          <a
            href={site.marshmallow.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-brand px-6 py-3 font-semibold text-surface transition hover:bg-brand-strong"
          >
            マシュマロで質問を送る
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // キーワード検索(カテゴリ横断)。JS 無効時は全件表示のまま(絞り込み UI のみ機能しない)
  import { faqTextMatches } from "../lib/faq";

  const search = document.getElementById("faq-search") as HTMLInputElement | null;
  const sections = document.querySelectorAll<HTMLElement>("[data-faq-section]");
  const count = document.getElementById("faq-count");
  const empty = document.getElementById("faq-empty");

  function applyFilter(): void {
    const query = (search?.value ?? "").trim().toLowerCase();
    let matched = 0;
    for (const section of sections) {
      let visibleInSection = 0;
      for (const item of section.querySelectorAll<HTMLElement>("[data-faq-item]")) {
        const isMatch = faqTextMatches(
          item.dataset.question ?? "",
          item.dataset.answer ?? "",
          query,
        );
        item.hidden = !isMatch;
        if (isMatch) visibleInSection += 1;
      }
      section.hidden = visibleInSection === 0;
      matched += visibleInSection;
    }
    if (count) count.textContent = `${matched} 件`;
    if (empty) empty.hidden = matched > 0;
  }

  search?.addEventListener("input", applyFilter);
  applyFilter();
</script>
