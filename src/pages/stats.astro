---
import Breadcrumb from "../components/Breadcrumb.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SubscribeMilestoneNote from "../components/SubscribeMilestoneNote.astro";
import { site, subscribeUrl } from "../config/site";
import channelStatsHistoryJson from "../data/channel-stats-history.json";
import channelStatsJson from "../data/channel-stats.json";
import videosJson from "../data/videos.json";
import Base from "../layouts/Base.astro";
import { buildBreadcrumbJsonLd, type BreadcrumbItem } from "../lib/breadcrumb";
import {
  buildChannelStatsView,
  formatSubscriberCountFull,
  parseChannelStats,
} from "../lib/channelStats";
import {
  buildSparklinePoints,
  buildSubscriberTrendSummary,
  buildViewCountSparklinePoints,
  buildViewCountTrendSummary,
  findViewCountHistoryStartDate,
  parseChannelStatsHistory,
  sparklinePointsToPolyline,
} from "../lib/channelStatsHistory";
import { formatViewCountFull } from "../lib/format";
import { computeUpdateFrequencyLabel } from "../lib/updateFrequency";
import { parseVideosData } from "../lib/youtube";

/**
 * チャンネル成長ダッシュボード(#407)。
 * `channel-stats-history.json` は日次cronで蓄積される一方、これまでの活用箇所は
 * トップページの幅88pxのスパークラインのみで、蓄積データのほとんどが表に出ていなかった。
 * 「地道に成長中の等身大チャンネル」という物語性を伝え、応援したくなる訪問者の後押しにする。
 */

const { videos } = parseVideosData(videosJson);
// チャンネル統計(登録者数・総再生回数・動画本数・最終更新時刻)はトップ・動画ライブラリ
// ページと同じ正規化ロジックを通し、ページ間で表示が食い違わないようにする(#438)。
const channelStats = parseChannelStats(channelStatsJson);
const statsView = buildChannelStatsView(channelStats, videos.length, new Date());
const channelStatsHistory = parseChannelStatsHistory(channelStatsHistoryJson);

const updateFrequencyText = computeUpdateFrequencyLabel(videos, new Date());

// トップページのスパークライン(88x24)より大きく、推移が読み取りやすいサイズにする
const CHART_WIDTH = 320;
const CHART_HEIGHT = 96;
const subscriberSparkline = buildSparklinePoints(channelStatsHistory, CHART_WIDTH, CHART_HEIGHT);
const subscriberPolyline = subscriberSparkline
  ? sparklinePointsToPolyline(subscriberSparkline)
  : null;
const viewCountSparkline = buildViewCountSparklinePoints(
  channelStatsHistory,
  CHART_WIDTH,
  CHART_HEIGHT,
);
const viewCountPolyline = viewCountSparkline ? sparklinePointsToPolyline(viewCountSparkline) : null;

// スパークラインは折れ線の傾きで増減を視覚的に伝えるが、同じ情報がスクリーンリーダー
// 利用者には渡らないため、開始値・終了値・増減をテキストで要約する(#481)。
// formatSubscriberCount/formatViewCount(1万以上を「○.○万」に丸める表示用フォーマッタ)
// ではなく、丸めない *Full 版を使う。丸めた値だと、実際は異なる開始値・終了値が同じ
// 表示文字列に収束し、増減テキストと矛盾しうるため(レビュー指摘 #484)。
const subscriberTrendSummary = buildSubscriberTrendSummary(
  channelStatsHistory,
  formatSubscriberCountFull,
);
const viewCountTrendSummary = buildViewCountTrendSummary(channelStatsHistory, formatViewCountFull);

const historyStartDate = channelStatsHistory[0]?.date ?? null;
// 総再生回数グラフは viewCount を持つエントリのみが対象のため、履歴全体の開始日とは
// 別に、この系列自身の実際の開始日を算出する(#435)。
const viewCountHistoryStartDate = findViewCountHistoryStartDate(channelStatsHistory);

const pageTitle = `チャンネル成長記録 | ${site.name}`;
const pageDescription = `${site.name} の登録者数・総再生回数の推移や動画本数、更新頻度をまとめた成長記録ページです。`;

if (!Astro.site) {
  throw new Error("astro.config.mjs の site が未設定です(canonical / JSON-LD の生成に必須)");
}
const siteUrl = Astro.site.toString();
const breadcrumbItems: BreadcrumbItem[] = [
  { name: "ホーム", href: "/" },
  { name: "チャンネル成長記録", href: "/stats/" },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: buildBreadcrumbJsonLd(breadcrumbItems, siteUrl),
    },
  ],
};
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={jsonLdSafe} slot="head" />
  <main id="main" class="mx-auto max-w-3xl px-4 pt-12 pb-24">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="text-3xl font-bold sm:text-4xl">チャンネル成長記録</h1>
    <p class="mt-3 text-ink-muted">
      {site.name} の登録者数・総再生回数の推移や動画本数をまとめました。地道に更新を続けている等身大のチャンネルの歩みを、時々のぞきに来てもらえたら嬉しいです。
    </p>

    <section aria-labelledby="stats-summary-heading" class="mt-12">
      <SectionHeading id="stats-summary-heading" title="現在の数字" />
      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        {
          statsView.subscriberText && (
            <div class="rounded-xl bg-surface-raised p-5">
              <dt class="text-sm text-ink-muted">チャンネル登録者数</dt>
              <dd class="mt-1 text-2xl font-black">{statsView.subscriberText}</dd>
            </div>
          )
        }
        {
          statsView.totalViewCountText && (
            <div class="rounded-xl bg-surface-raised p-5">
              <dt class="text-sm text-ink-muted">総再生回数</dt>
              <dd class="mt-1 text-2xl font-black">{statsView.totalViewCountText}</dd>
            </div>
          )
        }
        <div class="rounded-xl bg-surface-raised p-5">
          <dt class="text-sm text-ink-muted">動画本数</dt>
          <dd class="mt-1 text-2xl font-black">{statsView.videoCountText}</dd>
        </div>
      </dl>
      {
        /* 最終更新日時は取得成功時、更新失敗は一度も取得できていない場合に必ずどちらかを
        表示する(#438の受け入れ条件)。 */
      }
      <p class="mt-3 text-xs text-ink-muted">
        {
          statsView.fetchedAtText
            ? `${statsView.fetchedAtText}の数値です。`
            : statsView.updateFailedText
        }
      </p>
      <div class="mt-4">
        <SubscribeMilestoneNote subscriberCount={statsView.subscriberCount} />
      </div>
    </section>

    {
      updateFrequencyText && (
        <section aria-labelledby="stats-frequency-heading" class="mt-12">
          <SectionHeading id="stats-frequency-heading" title="更新頻度の目安" />
          <p class="text-ink-muted">
            直近の投稿間隔から算出した、おおよその更新ペースです。
            <span class="ml-1 font-semibold text-ink">{updateFrequencyText}</span>
          </p>
        </section>
      )
    }

    {
      (subscriberPolyline || viewCountPolyline) && (
        <section aria-labelledby="stats-trend-heading" class="mt-12">
          <SectionHeading
            id="stats-trend-heading"
            title="推移グラフ"
            subtitle="直近90日分の記録を保持しています。"
          />
          <div class="flex flex-col gap-8">
            {subscriberPolyline && (
              <div>
                <p class="mb-2 text-sm font-semibold text-ink-muted">チャンネル登録者数の推移</p>
                {historyStartDate && (
                  <p class="mb-2 text-xs text-ink-muted">
                    {historyStartDate} 以降の記録に基づく推移です。
                  </p>
                )}
                <figure class="w-full max-w-md">
                  <svg
                    width={CHART_WIDTH}
                    height={CHART_HEIGHT}
                    viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`}
                    class="w-full text-brand-accent"
                    role="img"
                    aria-labelledby={
                      subscriberTrendSummary ? "subscriber-trend-caption" : undefined
                    }
                    aria-label={
                      subscriberTrendSummary ? undefined : "チャンネル登録者数の推移グラフ"
                    }
                  >
                    <polyline
                      points={subscriberPolyline}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {subscriberTrendSummary && (
                    <figcaption
                      id="subscriber-trend-caption"
                      aria-hidden="true"
                      class="mt-2 text-xs text-ink-muted"
                    >
                      {subscriberTrendSummary}
                    </figcaption>
                  )}
                </figure>
              </div>
            )}
            {viewCountPolyline && (
              <div>
                <p class="mb-2 text-sm font-semibold text-ink-muted">総再生回数の推移</p>
                {viewCountHistoryStartDate && (
                  <p class="mb-2 text-xs text-ink-muted">
                    {viewCountHistoryStartDate} 以降の記録に基づく推移です。
                  </p>
                )}
                <figure class="w-full max-w-md">
                  <svg
                    width={CHART_WIDTH}
                    height={CHART_HEIGHT}
                    viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`}
                    class="w-full text-brand-accent"
                    role="img"
                    aria-labelledby={viewCountTrendSummary ? "viewcount-trend-caption" : undefined}
                    aria-label={viewCountTrendSummary ? undefined : "総再生回数の推移グラフ"}
                  >
                    <polyline
                      points={viewCountPolyline}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {viewCountTrendSummary && (
                    <figcaption
                      id="viewcount-trend-caption"
                      aria-hidden="true"
                      class="mt-2 text-xs text-ink-muted"
                    >
                      {viewCountTrendSummary}
                    </figcaption>
                  )}
                </figure>
              </div>
            )}
          </div>
        </section>
      )
    }

    <section aria-labelledby="stats-cta-heading" class="mt-12">
      <SectionHeading id="stats-cta-heading" title="応援してもらえると嬉しいです" />
      <p class="text-ink-muted">
        チャンネル登録・高評価が、日々の更新を続ける一番の励みになっています。よければぜひ応援してください。
      </p>
      <a
        href={subscribeUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-accent"
      >
        チャンネル登録する
      </a>
    </section>
  </main>
</Base>
